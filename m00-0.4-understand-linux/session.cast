[174.554861, "o", "\r\n\u001b[?2004l\r"]
[174.605775, "o", "=== request: POST http://127.0.0.1:11434/api/chat ===\r\n{\r\n  \"model\": \"gemma3:1b\",\r\n  \"messages\": [\r\n    {\r\n      \"role\": \"system\",\r\n      \"content\": \"You are the help desk bot for a demo shop.\"\r\n    },\r\n    {\r\n      \"role\": \"user\",\r\n      \"content\": \"What are your opening hours?\"\r\n    }\r\n  ],\r\n  \"stream\": false,\r\n  \"options\": {\r\n    \"seed\": 7\r\n  }\r\n}\r\n"]
[179.277864, "o", "\r\n=== reply ===\r\nOkay, I can help you with that! \r\n\r\nAs a demo shop, we’re open **Monday - Friday from 10:00 AM to 6:00 PM**. \r\n\r\n**Saturday & Sunday we're closed.**\r\n\r\nDo you have any other questions about our hours, or would you like me to help you with anything else?\r\n\r\n=== what the model read and wrote ===\r\n  31 tokens in: the note and the question, read as one text\r\n  75 tokens out: the reply, one token at a time\r\n"]
[179.288088, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m00\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m00\u001b[00m$ "]
[186.339133, "o", "exit\r\n\u001b[?2004l\rexit\r\n"]
