[59.784263, "o", "81:        mkdir -p \"/usr/local/bin\" 2>/dev/null || sudo mkdir -p \"/usr/local/bin\"\r\n83:            sudo ln -sf \"/Applications/Ollama.app/Contents/Resources/ollama\" \"/usr/local/bin/ollama\"\r\n112:    # Running as root, no need for sudo\r\n113:    if ! available sudo; then\r\n117:    SUDO=\"sudo\"\r\n140:  - Debian/Ubuntu: sudo apt-get install zstd\r\n141:  - RHEL/CentOS/Fedora: sudo dnf install zstd\r\n142:  - Arch: sudo pacman -S zstd\"\r\n200:        $SUDO useradd -r -s /bin/false -U -m -d /usr/share/ollama ollama\r\n231:    SYSTEMCTL_RUNNING=\"$(systemctl is-system-running || true)\"\r\n235:            $SUDO systemctl daemon-reload\r\n236:            $SUDO systemctl enable ollama\r\n"]
