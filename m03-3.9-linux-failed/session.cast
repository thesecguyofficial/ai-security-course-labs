[42.142184, "o", "none                  YES                no            YES           YES       0\r\n"]
[42.142947, "o", "label                 YES                no            YES           YES       0\r\n"]
[42.143413, "o", "plan                   no                no            YES           YES       1\r\n"]
[42.144045, "o", "confirm                no               YES            YES           YES       0\r\n"]
[42.144976, "o", "output                YES                no             no            no       2\r\n"]
[42.145599, "o", "all                    no                no             no            no       3\r\n(YES = the planted note got its way; for 'waiting approval' it reached a person's screen. `reset` clears state/.)\r\n"]
