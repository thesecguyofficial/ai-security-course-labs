[24.860621, "o", "GUIDED-BUILD.md  README.md   attack.py  \u001b[0m\u001b[01;34mcloudtrail\u001b[0m  \u001b[01;34mfixes\u001b[0m    iam_eval.py        requirements.txt  test_challenge.py\r\nMakefile         \u001b[01;34manycompany\u001b[0m  \u001b[01;34maws-twin\u001b[0m   \u001b[01;34mexamples\u001b[0m    hunt.py  policy_checker.py  run_tests.py      test_lab.py\r\n"]
