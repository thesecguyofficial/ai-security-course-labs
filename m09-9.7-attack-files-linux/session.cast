[26.496433, "o", "\r\n\u001b[?2004l\r"]
[26.582808, "o", "evil_model.pkl: 366 bytes, read as pickle instructions (nothing is run)\r\n\r\n    at  instruction       argument                                 meaning\r\n     0  PROTO             4                                        pickle format version\r\n     2  FRAME             355                                      size of the next chunk\r\n    11  SHORT_BINUNICODE  'builtins'                               push a piece of text\r\n    21  MEMOIZE                                                    keep a copy for later\r\n    22  SHORT_BINUNICODE  'exec'                                   push a piece of text\r\n    28  MEMOIZE                                                    keep a copy for later\r\n"]
[26.582889, "o", "    29  STACK_GLOBAL                                               IMPORT the named function or class\r\n    30  MEMOIZE                                                    keep a copy for later\r\n    31  BINUNICODE        \"import os;os.makedirs(r'/home/these...' push a piece of text\r\n   360  MEMOIZE                                                    keep a copy for later\r\n   361  TUPLE1                                                     pack 1 item as arguments\r\n   362  MEMOIZE                                                    keep a copy for later\r\n   363  REDUCE                                                     CALL it with those arguments\r\n   364  MEMOIZE                                                    keep a copy for later\r\n   365  STOP                                                       done: hand back the result\r\n\r\nimports (functions or classes it names): builtins.exec\r\ncalls (REDUCE and friends):              1\r\n-> loading this file would CALL builtins.exec. Don't load it; part 2 is about this.\r\n"]
[26.590794, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m09\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m09\u001b[00m$ "]
