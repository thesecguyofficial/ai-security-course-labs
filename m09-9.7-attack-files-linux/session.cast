[59.272015, "o", "\r\n\u001b[?2004l\r"]
[59.273925, "o", "        class Restricted(pickle.Unpickler):\r\n            # The allow-list here is empty: this toy model is plain lists and needs no globals.\r\n            # A real loader would allow only the few weight classes it expects.\r\n            def find_class(self, module, name):\r\n"]
[59.273989, "o", "                raise pickle.UnpicklingError(f\"global '{module}.{name}' is forbidden\")\r\n"]
[59.274313, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m09\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m09\u001b[00m$ "]
