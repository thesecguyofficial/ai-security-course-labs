[42.034232, "o", "     9\t  \"network\": {\r\n    10\t    \"mode\": \"PUBLIC\",\r\n    11\t    \"nat_gateway\": true,\r\n    12\t    \"security_group_egress\": [\r\n    13\t      {\"protocol\": \"tcp\", \"port\": 443, \"to\": \"0.0.0.0/0\"},\r\n    14\t      {\"protocol\": \"udp\", \"port\": 53, \"to\": \"0.0.0.0/0\"}\r\n    15\t    ]\r\n    16\t  },\r\n    17\t  \"endpoints\": [\r\n    18\t    {\"service\": \"s3\", \"type\": \"gateway\", \"policy\": \"full-access\"},\r\n    19\t    {\"service\": \"bedrock-runtime\", \"type\": \"interface\", \"policy\": \"full-access\"}\r\n    20\t  ],\r\n    21\t  \"dns\": {\r\n    22\t    \"firewall\": false,\r\n    23\t    \"default_action\": \"ALLOW\",\r\n    24\t    \"allow\": [],\r\n    25\t    \"fail_open\": true,\r\n    26\t    \"query_logging\": false\r\n    27\t  },\r\n    28\t  \"proxy\": {\r\n    29\t    \"enabled\": true,\r\n    30\t    \"enforced_by_network\": false,\r\n    31\t    \"allow\": [\r\n    32\t      {\"name\": \"*.amazonaws.com\", \"methods\": [\"*\"]},\r\n    33\t      {\"name\": \"pypi.tsg.example\", \"methods\": [\"*\"]}\r\n    34\t    ]\r\n    35\t  },\r\n"]
