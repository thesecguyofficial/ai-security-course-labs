[7.504454, "o", "GUIDED-BUILD.md  anycompany.json  \u001b[0m\u001b[01;34mcloud\u001b[0m       evaluate.py        \u001b[01;34mguardrails\u001b[0m   \u001b[01;34morg\u001b[0m           \u001b[01;34msuite\u001b[0m\r\nMakefile         \u001b[01;34mapp\u001b[0m              \u001b[01;34mdata\u001b[0m        explore.py         helpdesk.py  \u001b[01;34mpolicies\u001b[0m      test_challenge.py\r\nREADME.md        checker.py       enforce.py  guardrail_twin.py  iam_eval.py  run_tests.py  test_lab.py\r\n"]
