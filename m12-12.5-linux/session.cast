[24.840823, "o", "\r\n\u001b[?2004l\r"]
[24.842196, "o", "{\r\n  \"_about\": \"The Friday pull request: the Converse request TSG Helpdesk sends with the guardrail turned on. Copied from an AWS example, but the wrong way round.\",\r\n  \"guardrailConfig\": {\r\n    \"guardrailIdentifier\": \"arn:aws:bedrock:us-east-1:111122223333:guardrail/tsghelpdesk01\",\r\n    \"guardrailVersion\": \"DRAFT\",\r\n    \"trace\": \"disabled\",\r\n    \"streamProcessingMode\": \"async\"\r\n  },\r\n  \"system\": [{\"text\": \"{system}\"}],\r\n  \"messages\": [\r\n    {\"role\": \"user\", \"content\": [\r\n      {\"text\": \"Reference: {kb}\"},\r\n      {\"text\": \"{question}\"},\r\n      {\"guardContent\": {\"text\": {\"text\": \"Answer in plain English.\"}}}\r\n    ]}\r\n  ]\r\n}\r\n"]
