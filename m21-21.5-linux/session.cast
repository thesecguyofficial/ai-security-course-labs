[44.848634, "o", "  \"_comment\": \"FIRST DRAFT of the policy enforcement  |\t  \"_comment\": \"HARDENED policy enforcement point. Sam\r\n  \"name\": \"first-draft\",\t\t\t      |\t  \"name\": \"hardened\",\r\n  \"parse\": \"first-wins\",\t\t\t      |\t  \"parse\": \"strict\",\r\n  \"validate_with_schema\": false,\t\t      |\t  \"validate_with_schema\": true,\r\n  \"principal\": \"args-then-session\",\t\t      |\t  \"principal\": \"session\",\r\n  \"unknown_tools\": \"trust-annotations\",\t\t      |\t  \"unknown_tools\": \"deny\",\r\n  \"no_decision\": \"allow\",\t\t\t      |\t  \"no_decision\": \"deny\",\r\n  \"engine_error\": \"allow\",\t\t\t      |\t  \"engine_error\": \"deny\",\r\n  \"approval\": \"by-id-from-model\",\t\t      |\t  \"approval\": \"signed-and-bound\",\r\n  \"window_counters\": false,\t\t\t      |\t  \"window_counters\": true,\r\n  \"tool_gets\": \"raw-arguments\"\t\t\t      |\t  \"tool_gets\": \"validated-arguments\"\r\n"]
