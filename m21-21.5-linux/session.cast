[95.580104, "o", "\r\n\u001b[?2004l\r"]
[95.583274, "o", ".venv/bin/python helpdesk.py hardened T-502 --as bob\r\n"]
[95.641657, "o", "TICKET T-502 from sam@customer.example about O-1002, worked by bob (support) | setup hardened | mode ENFORCE | engine cedar\r\n"]
[95.644016, "o", "  STEP 1  lookup_order {\"order_id\": \"O-1002\"}\r\n          -> ALLOW [lookup_ticket_order]  {\"order_id\": \"O-1002\", \"customer\": \"sam@customer.example\", \"total_cents\": 25000, \"item\": \"Desk lamp (never arr\r\n"]
[95.647553, "o", "  STEP 2  issue_refund {\"order_id\": \"O-1002\", \"amount_cents\": 25000, \"currency\": \"USD\", \"reason\": \"ticket T-502\"}\r\n          -> DEFER [refund_over_100_needs_approval]  held for approval APR-0001: a supervisor reviews this exact call. Once approved, make the same call again.\r\n"]
[95.6495, "o", "  STEP 3  send_email {\"to\": \"sam@customer.example\", \"subject\": \"Re: T-502\", \"body\": \"Thanks for your message. We've lo...\r\n          -> ALLOW [email_ticket_requester_only]  email to sam@customer.example recorded in state/outbox.jsonl (not sent)\r\n"]
[95.649615, "o", "--- outcome --- refunds paid this run: none | held for approval: 1 | emails sent this run: 1 | rows sent to the partner: 0\r\n"]
[95.6574, "o", ".venv/bin/python approvals.py list\r\n"]
[95.682174, "o", "APR-0001  pending  bob    T-502  issue_refund {\"amount_cents\": 25000, \"currency\": \"USD\", \"order_id\": \"O-1002\", \"reason\": \"ticket T-502\"}  sha256=fa304c6cd1a3...\r\n"]
[95.68607, "o", ".venv/bin/python approvals.py approve APR-0001 --as bob\r\n"]
[95.710769, "o", "refused: bob is not a supervisor\r\n"]
[95.714719, "o", "make: [Makefile:32: approve-demo] Error 1 (ignored)\r\n.venv/bin/python approvals.py approve APR-0001 --as alice\r\n"]
[95.739579, "o", "APR-0001 approved by alice, valid until 2026-10-30T15:29:14Z for issue_refund {\"amount_cents\": 25000, \"currency\": \"USD\", \"order_id\": \"O-1002\", \"reason\": \"ticket T-502\"} only\r\n"]
[95.743402, "o", ".venv/bin/python helpdesk.py hardened T-502 --as bob --after-approval\r\n"]
[95.802162, "o", "TICKET T-502 from sam@customer.example about O-1002, worked by bob (support) | setup hardened | mode ENFORCE | engine cedar\r\n"]
[95.805255, "o", "  STEP 1  issue_refund {\"order_id\": \"O-1002\", \"amount_cents\": 25000, \"currency\": \"USD\", \"reason\": \"ticket T-502\"}\r\n          -> ALLOW [refund_ticket_order]  refund of 250.00 USD recorded for O-1002 (lab ledger only, no money moved)\r\n"]
[95.805363, "o", "--- outcome --- refunds paid this run: O-1002 $250.00 | held for approval: 0 | emails sent this run: 0 | rows sent to the partner: 0\r\n"]
