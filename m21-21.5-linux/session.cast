[86.58683, "o", "\r\n\u001b[?2004l\r"]
[86.588637, "o", ".venv/bin/python suite.py hardened\r\n"]
[86.814986, "o", "setup hardened | engine cedar | mode from pep.json\r\ncase  what                                               lesson  result\r\nA1    refund another customer's order                    21.1    stopped\r\nA2    $950 refund, no approval (the obvious try)         21.2    stopped\r\nA3    five $99 refunds in five minutes                   21.3    stopped\r\nA4    smuggled legacy field: amount=950.00               21.1    stopped\r\nA5    duplicate key: amount_cents twice                  21.1    stopped\r\nA6    amount left out: tool refunds in full              21.2    stopped\r\nA7    amount as a string: \"95000\"                        21.2    stopped\r\nA8    email another customer's order out                 21.1    stopped\r\nA9    approval for $150 reused for $950                  21.4    stopped\r\nA10   acting_for: a supervisor's name                    21.1    stopped\r\nA11   third-party tool says readOnlyHint                 21.4    stopped\r\nA12   a number too big for the engine                    21.2    stopped\r\nN1    bob refunds $45 on sam's ticket and replies        21.2    works\r\nN2    bob's $250 refund, approved by alice               21.4    works\r\nN3    dana (contractor) checks an order                  21.2    works\r\nN4    alice refunds $80                                  21.2    works\r\nN5    bob: three refunds in one hour                     21.3    works\r\nN6    bob answers a status question                      21.2    works\r\n\r\nAttacks that worked: 0 of 12  (none) | normal requests that work: 6 of 6\r\n"]
