[211.98313, "o", "\r\n\u001b[?2004l\r"]
[212.01891, "o", "  \u001b[01;31m\u001b[KKEPT\u001b[m\u001b[K     Per-user retrieval from the SESSION, not the request  [M6 retrieve_safe]\r\n  \u001b[01;31m\u001b[KKEPT\u001b[m\u001b[K     No model-chosen scope  [M6 retrieve_safe]\r\n  \u001b[01;31m\u001b[KKEPT\u001b[m\u001b[K     Who may write to the corpus  [M6 ingest_safe]\r\n  \u001b[01;31m\u001b[KPARTIAL\u001b[m\u001b[K  Hidden-instruction screening / spotlighting  [M6 ingest_safe, M7 wrap_untrusted]\r\n  \u001b[01;31m\u001b[KKEPT\u001b[m\u001b[K     Encrypted, owner-only store  [M6.4 hardening]\r\n  \u001b[01;31m\u001b[KKEPT\u001b[m\u001b[K     Tool allow-list per task  [M7 policy.json tasks]\r\n  \u001b[01;31m\u001b[KKEPT\u001b[m\u001b[K     Human approval before writes, arguments shown  [M7 approval_card]\r\n  \u001b[01;31m\u001b[KPARTIAL\u001b[m\u001b[K  Authorisation in code, caller from the session  [M7 check_data_scope]\r\n  \u001b[01;31m\u001b[KKEPT\u001b[m\u001b[K     Least-privilege tool identity  [M7.4]\r\n  \u001b[01;31m\u001b[KKEPT\u001b[m\u001b[K     Append-only audit log  [M7 audit + verify_chain]\r\n\u001b[01;31m\u001b[KKept\u001b[m\u001b[K 8 of 10 controls, partial 2, lost 0\r\n"]
