[153.194211, "o", "\r\n\u001b[?2004l\r"]
[153.265768, "o", "A rate limit: at most 3 refunds an hour per signed-in user (max_3_refunds_per_hour.cedar)\r\nThe PEP counts bob's ALLOWED refunds in the last 60 minutes and passes the number as context.window.\r\nHere the past calls are a list in memory: nothing is written.\r\n\r\n"]
[153.271826, "o", "  09:00  bob  issue_refund O-1001 4500 cents   refunds_1h = 0   -> ALLOW [refund_ticket_order]\r\n"]
[153.27303, "o", "  09:10  bob  issue_refund O-1001 4500 cents   refunds_1h = 1   -> ALLOW [refund_ticket_order]\r\n"]
[153.274184, "o", "  09:20  bob  issue_refund O-1001 4500 cents   refunds_1h = 2   -> ALLOW [refund_ticket_order]\r\n"]
[153.275325, "o", "  09:30  bob  issue_refund O-1001 4500 cents   refunds_1h = 3   -> DENY  [max_3_refunds_per_hour]\r\n"]
[153.276446, "o", "  10:05  bob  issue_refund O-1001 4500 cents   refunds_1h = 2   -> ALLOW [refund_ticket_order]\r\n\r\nAt 10:05 the 09:00 refund is more than an hour old, so it no longer counts.\r\n"]
