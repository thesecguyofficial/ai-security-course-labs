[129.599439, "o", "\r\n\u001b[?2004l\r"]
[129.631273, "o", "setups/hardened/policies/refund_ticket_order.cedar\r\n\r\n  // Support agents and supervisors may refund an order that belongs to the ticket's customer.\r\n  @id(\"refund_ticket_order\")\r\n  permit (principal, action == TSG::Action::\"issue_refund\", resource is TSG::Order)\r\n  when {\r\n      [\"support\", \"supervisor\"].contains(principal.role) &&\r\n      resource.customer == context.ticket.requester\r\n  };\r\n\r\nRead it part by part:\r\n  @id(\"refund_ticket_order\")                           a name for the rule; decisions report it\r\n  permit                                               the effect: allow when this rule matches\r\n    principal                                          WHO: any user, unless narrowed below\r\n    action == TSG::Action::\"issue_refund\"              WHAT: the action (tool)\r\n    resource is TSG::Order                             ON WHAT: the resource\r\n  when                                                 only if everything inside is true\r\n    [\"support\", \"supervisor\"].contains(principal.role) &&\r\n    resource.customer == context.ticket.requester\r\n  (&& means AND: every line inside must be true)\r\n"]
[129.63706, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m21\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m21\u001b[00m$ "]
