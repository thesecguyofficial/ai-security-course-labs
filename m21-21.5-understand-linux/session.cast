[54.866883, "o", "{\r\n  \"_comment\": \"Helpdesk staff who sign in to the web app. The PEP takes the signed-in user from the session, never from tool arguments.\",\r\n  \"bob\":   {\"role\": \"support\",    \"about\": \"support agent, works customer tickets\"},\r\n  \"alice\": {\"role\": \"supervisor\", \"about\": \"support supervisor, approves refunds over $100\"},\r\n  \"dana\":  {\"role\": \"contractor\", \"about\": \"contractor, may look orders up but not refund\"}\r\n}\r\n{\r\n  \"_comment\": \"Fake orders. Money is in integer cents (USD). Addresses use names reserved for documentation (RFC 2606): nothing here is real.\",\r\n  \"O-1001\": {\"customer\": \"sam@customer.example\",   \"total_cents\": 4500,   \"item\": \"Ceramic mug (arrived broken)\"},\r\n  \"O-1002\": {\"customer\": \"sam@customer.example\",   \"total_cents\": 25000,  \"item\": \"Desk lamp (never arrived)\"},\r\n  \"O-1003\": {\"customer\": \"sam@customer.example\",   \"total_cents\": 8000,   \"item\": \"Notebook set\"},\r\n  \"O-1004\": {\"customer\": \"sam@customer.example\",   \"total_cents\": 6000,   \"item\": \"Phone stand\"},\r\n  \"O-2001\": {\"customer\": \"lee@customer.example\",   \"total_cents\": 120000, \"item\": \"Office chair\", \"address\": \"FAKE-ADDRESS 12 Example Road\"},\r\n  \"O-3001\": {\"customer\": \"mallory@attacker.example\", \"total_cents\": 120000, \"item\": \"Standing desk\"},\r\n  \"O-3002\": {\"customer\": \"mallory@attacker.example\", \"total_cents\": 9000,   \"item\": \"Cable tray\"}\r\n}\r\n"]
