[25.063385, "o", "\r\n\u001b[?2004l\r"]
[25.10943, "o", "  CRIT  AUTH-01  \u001b[01;31m\u001b[K 26.0 \u001b[m\u001b[K the gateway accepts requests without a key\r\n                       gateway.json: require_auth is false\r\n  HIGH  AUTH-02  \u001b[01;31m\u001b[K 26.0 \u001b[m\u001b[K the gateway's path allow-list lets management paths through\r\n                       gateway.json: allow_paths has /*\r\n  HIGH  CACHE-01 \u001b[01;31m\u001b[K 26.2 \u001b[m\u001b[K the prefix cache is shared across tenants\r\n                       gateway.json: cache_scope is 'shared'\r\n  HIGH  DEV-01   \u001b[01;31m\u001b[K 26.0 \u001b[m\u001b[K VLLM_SERVER_DEV_MODE=1 turns on development endpoints\r\n                       docker-compose.yml: vllm: VLLM_SERVER_DEV_MODE=1\r\n  HIGH  EXP-01   \u001b[01;31m\u001b[K 26.0 \u001b[m\u001b[K an engine port is published on every host address\r\n                       docker-compose.yml: ollama: ports \"11434:11434\" listens on 0.0.0.0 and [::] of the host\r\n  HIGH  EXP-01   \u001b[01;31m\u001b[K 26.0 \u001b[m\u001b[K an engine port is published on every host address\r\n                       docker-compose.yml: ray-head: ports \"8265:8265\" listens on 0.0.0.0 and [::] of the host\r\n  HIGH  EXP-01   \u001b[01;31m\u001b[K 26.0 \u001b[m\u001b[K an engine port is published on every host address\r\n                       docker-compose.yml: triton: ports \"8001:8001\" listens on 0.0.0.0 and [::] of the host\r\n  HIGH  EXP-01   \u001b[01;31m\u001b[K 26.0 \u001b[m\u001b[K an engine port is published on every host address\r\n                       docker-compose.yml: vllm: ports \"8000:8000\" listens on 0.0.0.0 and [::] of the host\r\n  HIGH  EXP-02   \u001b[01;31m\u001b[K 26.0 \u001b[m\u001b[K a model server is exposed by a LoadBalancer or NodePort Service\r\n"]
[25.109615, "o", "                       k8s: Service vllm: type LoadBalancer\r\n  MED   CACHE-02 \u001b[01;31m\u001b[K 26.2 \u001b[m\u001b[K the gateway hands tenants per-request timing\r\n                       gateway.json: expose_timing is true\r\n  LOW   AUTH-03  \u001b[01;31m\u001b[K 26.0 \u001b[m\u001b[K vLLM runs without --api-key (a second lock behind the gateway)\r\n                       docker-compose.yml: vllm: no --api-key in the command\r\n"]
