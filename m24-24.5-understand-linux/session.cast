[42.41253, "o", "\r\n\u001b[?2004l\r"]
[42.414454, "o", "{\r\n  \"_note\": \"The crew and its scopes. Your containment reads this. Addresses use reserved .example names (RFC 2606).\",\r\n  \"agents\": [\"intake\", \"planner\", \"mailer\"],\r\n  \"agent_tools\": {\r\n    \"intake\": [],\r\n    \"planner\": [],\r\n    \"mailer\": [\"send_email\"]\r\n  },\r\n  \"send_email_domains\": {\r\n    \"mailer\": [\"tsg.example\"]\r\n  },\r\n  \"propagation_threshold\": 2\r\n}\r\n"]
