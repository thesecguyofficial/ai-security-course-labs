[174.317424, "o", "e"]
[174.424258, "o", "."]
[174.564557, "o", "p"]
[174.682195, "o", "y"]
[174.787295, "o", " "]
[174.931857, "o", "v"]
[175.03228, "o", "a"]
[175.120081, "o", "r"]
[175.211008, "o", "i"]
