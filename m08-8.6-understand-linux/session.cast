[119.577943, "o", "p"]
[120.064787, "o", "\r\n\u001b[?2004l\r"]
[121.263956, "o", "servers/secure_http_server.py is running on http://127.0.0.1:8808/mcp: Streamable HTTP, one POST per message.\r\n\r\nhost -> server, with NO token:\r\n  POST http://127.0.0.1:8808/mcp\r\n  MCP-Protocol-Version: 2026-07-28\r\n  Mcp-Method: tools/list\r\n  body: {\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/list\", \"params\": {\"_meta\": {...}}}\r\n\r\nserver -> host:\r\n  HTTP 401\r\n  WWW-Authenticate: Bearer error=\"invalid_token\", error_description=\"Authentication required\", resource_metadata=\"http://127.0.0.1:8808/.well-known/oauth-protected-resource/mcp\"\r\n"]
[121.264809, "o", "\r\nThe host follows that pointer (Protected Resource Metadata):\r\n  GET http://127.0.0.1:8808/.well-known/oauth-protected-resource/mcp\r\n"]
[121.264926, "o", "  {\r\n    \"resource\": \"http://127.0.0.1:8808/mcp\",\r\n    \"authorization_servers\": [\"https://issuer.lab.invalid/\"],\r\n    \"scopes_supported\": [\"notes:read\"],\r\n    \"bearer_methods_supported\": [\"header\"]\r\n  }\r\n"]
[121.478887, "o", "\r\nNo token, no tools. The metadata says which authorization server issues tokens for this resource.\r\n"]
[121.561555, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m08\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m08\u001b[00m$ "]
