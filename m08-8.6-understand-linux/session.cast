[71.068332, "o", "\r\n\u001b[?2004l\r"]
[72.350107, "o", "The host starts servers/notes_server.py as a child process. They talk over stdio: the host writes\r\nto the server's standard input, the server answers on its standard output. One JSON-RPC message per line.\r\n\r\nhost -> server (one line on stdin):\r\n{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"server/discover\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientInfo\":{\"name\":\"explore.py\",\"version\":\"1.0\"},\"io.modelcontextprotocol/clientCapabilities\":{}}}}\r\n\r\nserver -> host (one line on stdout):\r\n{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"cacheScope\":\"private\",\"capabilities\":{\"prompts\":{\"listChanged\":true},\"resources\":{\"listChanged\":true,\"subscribe\":true},\"tools\":{\"listChanged\":true}},\"resultType\":\"complete\",\"supportedVersions\":[\"2026-07-28\"],\"ttlMs\":0,\"_meta\":{\"io.modelcontextprotocol/serverInfo\":{\"name\":\"notes\",\"version\":\"1.0.0\"}}}}\r\n\r\nThe answer, laid out to read:\r\n"]
[72.350334, "o", "{\r\n  \"jsonrpc\": \"2.0\",\r\n  \"id\": 1,\r\n  \"result\": {\r\n    \"cacheScope\": \"private\",\r\n    \"capabilities\": {\r\n      \"prompts\": {\"listChanged\": true},\r\n      \"resources\": {\"listChanged\": true, \"subscribe\": true},\r\n      \"tools\": {\"listChanged\": true}\r\n    },\r\n    \"resultType\": \"complete\",\r\n    \"supportedVersions\": [\"2026-07-28\"],\r\n    \"ttlMs\": 0,\r\n    \"_meta\": {\"io.modelcontextprotocol/serverInfo\": {\"name\": \"notes\", \"version\": \"1.0.0\"}}\r\n  }\r\n}\r\n"]
[72.434959, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m08\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m08\u001b[00m$ "]
