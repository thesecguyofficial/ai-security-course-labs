[62.283777, "o", "python3 model_files.py build\r\n"]
[62.317239, "o", "artifacts/v1-pickle/  v1: the first draft's fine-tuned export (pickle-based weights)\r\n"]
[62.317606, "o", "artifacts/v2-safe/  v2: safetensors weights, hashes recorded at approval (hardened)\r\n"]
[62.31799, "o", "artifacts/v3-unvetted/  v3: a new upload waiting for approval: pickle weights, no licence, no hashes\r\n"]
[62.318421, "o", "artifacts/v4-safe/  v4: a clean new version waiting for approval\r\n"]
[62.318828, "o", "artifacts/bob-experiment/  a data scientist's own experiment (not registered)\r\n"]
[62.319227, "o", "artifacts/hub-pull/  what a container gets when it downloads from the Hub at start\r\n"]
[62.324153, "o", "python3 model_files.py scan artifacts/v1-pickle\r\n"]
[62.35762, "o", "[OK  ] config.json                  data         \r\n[STOP] pytorch_model.bin            pickle       pickle-based weights (code can run when a loader unpickles it)  imports: builtins.print\r\n[OK  ] tokenizer.json               data         \r\n\r\nverdict: DO NOT SHIP (1 file(s) to fix)\r\n"]
[62.362619, "o", "make: [Makefile:28: scan] Error 1 (ignored)\r\npython3 model_files.py scan artifacts/v2-safe\r\n"]
