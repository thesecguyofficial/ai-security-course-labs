[107.638207, "o", "\r\n\u001b[?2004l\r"]
[107.640519, "o", "python3 checker.py hardened\r\n"]
[107.687682, "o", "[MEDIUM] M15-22 (15.3) no approval gate: nothing checks formats, hashes, licence and approver before a version becomes Approved (ch\r\n[MEDIUM] M15-23 (15.2) no SCP requires network isolation and a VPC on CreateModel: an admin's quick test can still ship a container\r\n\r\n0 HIGH, 2 MEDIUM, 0 LOW  (2 findings)\r\n"]
[107.694238, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m15\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m15\u001b[00m$ "]
