[176.13148, "o", "\r\n\u001b[?2004l\r"]
[176.133245, "o", "\u001b[01;31m\u001b[K## \u001b[m\u001b[KStep 0 · Before you start (15 minutes)\r\n\u001b[01;31m\u001b[K## \u001b[m\u001b[KA1 · Create it from zero\r\n\u001b[01;31m\u001b[K## \u001b[m\u001b[KA2 · Check the plumbing\r\n\u001b[01;31m\u001b[K## \u001b[m\u001b[KB1 · Download, then read the licence\r\n\u001b[01;31m\u001b[K## \u001b[m\u001b[KB2 · Scan it, the same scanner as the offline lab\r\n\u001b[01;31m\u001b[K## \u001b[m\u001b[KB3 · Upload it, encrypted, to the released-models path\r\n\u001b[01;31m\u001b[K## \u001b[m\u001b[KD1 · The schedule that deletes the endpoint (create it now)\r\n"]
[176.133385, "o", "\u001b[01;31m\u001b[K## \u001b[m\u001b[KD2 · Create the model, the configuration and the endpoint\r\n\u001b[01;31m\u001b[K## \u001b[m\u001b[KD3 · Check what you built\r\n\u001b[01;31m\u001b[K## \u001b[m\u001b[KE1 · A normal summary, through the private path\r\n\u001b[01;31m\u001b[K## \u001b[m\u001b[KE2 · Stolen keys, used from your laptop\r\n\u001b[01;31m\u001b[K## \u001b[m\u001b[KE3 · A prompt with personal data, and where it ends up\r\n\u001b[01;31m\u001b[K## \u001b[m\u001b[KE4 · A burst of calls, and the metrics\r\n\u001b[01;31m\u001b[K## \u001b[m\u001b[KE5 · The evidence in CloudTrail\r\n"]
[176.133698, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m15\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m15\u001b[00m$ "]
