[85.452662, "o", "    0: \\x80 PROTO      2\r\n    2: c    GLOBAL     'collections OrderedDict'\r\n   27: )    EMPTY_TUPLE\r\n   28: R    REDUCE\r\n"]
[85.452745, "o", "   29: 0    POP\r\n   30: c    GLOBAL     'builtins print'\r\n   46: X    BINUNICODE 'LAB-PLACEHOLDER: a real payload would run here'\r\n   97: \\x85 TUPLE1\r\n   98: R    REDUCE\r\n   99: 0    POP\r\n  100: }    EMPTY_DICT\r\n  101: .    STOP\r\nhighest protocol among opcodes = 2\r\n"]
