[29.495744, "o", "\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcheck_request(user: dict, message: str, state: dict) -> Decision:\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcheck_mcp_tools(tools: list[dict], pins: dict) -> list[dict]:\r\n\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kfilter_retrieval(user: dict, docs: list) -> list:\r\n\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kscreen_retrieved(text: str, doc) -> str:\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kauthorize_tool_call(call: ToolCall, ctx: Ctx) -> Decision:\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kscreen_tool_result(tool: str, text: str) -> str:\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kscreen_output(text: str, ctx: Ctx) -> str:\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Krender_html(text: str) -> str:\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kresponse_headers() -> dict:\r\n"]
