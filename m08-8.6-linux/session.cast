[109.753316, "o", "\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    PyJWT does the audience check for us: passing \u001b[01;31m\u001b[Kaudience=\u001b[m\u001b[KRESOURCE_URL makes decode() raise if the\r\n\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kaudience=\u001b[m\u001b[KRESOURCE_URL,        # reject tokens minted for any other resource (RFC 8707)\r\n"]
