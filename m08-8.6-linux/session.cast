[32.443739, "o", "\r\n\u001b[?2004l\r"]
[33.826203, "o", "--------------------------------------------------------------------\r\nnotes:list_notes\r\n  description: 'List the notes in the team workspace.'\r\n  input schema: {\"type\": \"object\", \"properties\": {}, \"title\": \"list_notesArguments\"}\r\n  VERDICT: looks clean\r\n--------------------------------------------------------------------\r\nnotes:read_note\r\n  description: 'Read one note from the team workspace by its file name, for example meeting-notes.md.'\r\n"]
[33.826379, "o", "  input schema: {\"type\": \"object\", \"properties\": {\"name\": {\"title\": \"Name\", \"type\": \"string\"}}, \"required\": [\"name\"], \"title\": \"read_noteArguments\"}\r\n  VERDICT: looks clean\r\n--------------------------------------------------------------------\r\nnotes:send_email\r\n  description: 'Send an email to a colleague. (Lab: writes to state/outbox.jsonl; nothing is sent.)'\r\n  input schema: {\"type\": \"object\", \"properties\": {\"to\": {\"title\": \"To\", \"type\": \"string\"}, \"subject\": {\"title\": \"Subject\", \"type\": \"string\"}, \"body\": {\"title\": \"Body\", \"type\": \"string\"}}, \"required\": [\"to\", \"subject\", \"body\"], \"title\": \"send_emailArguments\"}\r\n  VERDICT: looks clean\r\n--------------------------------------------------------------------\r\n0 of 3 tool(s) flagged on notes.\r\n"]
