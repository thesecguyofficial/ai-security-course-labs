{
  "name": "m23-23.5-linux",
  "lesson": "23.5",
  "title": "Lab 23.5, part 2: the recorded trail read, the poisoned ticket and the two exits opened, the empty starter defence, the replay before (0 of 5), a first defence that copies the recorded words (5 of 5 recorded, 0 of 5 variants), a defence built on behaviour read function by function, the replay after (PASS), the decision log, the tests and the challenge",
  "cols": 132,
  "rows": 36,
  "before": [
    "git clone -q https://github.com/thesecguyofficial/ai-security-course-labs.git",
    "echo  | base64 -d > ~/my-defense.py",
    "echo  | base64 -d > ~/naive-defense.py"
  ],
  "fail_on": [
    "Traceback",
    "No such file"
  ],
  "steps": [
    {
      "label": "Investigate",
      "type": "cd ai-security-course-labs/labs/m23 && make investigate",
      "pause_after": 7
    },
    {
      "label": "Attack file",
      "type": "grep -E '\"(e07|e09|e10)\"' data/trace/app-log.jsonl | fold -s -w 130",
      "pause_after": 7
    },
    {
      "label": "Starter",
      "type": "grep -n -A1 'TODO' defense.py",
      "pause_after": 6
    },
    {
      "label": "Before",
      "type": "make replay",
      "pause_after": 6
    },
    {
      "label": "Wording",
      "type": "cp ~/naive-defense.py defense.py && cat defense.py",
      "pause_after": 7
    },
    {
      "label": "Wording replay",
      "type": "make replay",
      "pause_after": 7
    },
    {
      "label": "Behaviour 1",
      "type": "cp ~/my-defense.py defense.py && sed -n 1,23p defense.py",
      "pause_after": 8
    },
    {
      "label": "Behaviour 2",
      "type": "sed -n 26,42p defense.py",
      "pause_after": 8
    },
    {
      "label": "Behaviour 3",
      "type": "sed -n 45,64p defense.py",
      "pause_after": 8
    },
    {
      "label": "Replay",
      "type": "make replay",
      "pause_after": 6
    },
    {
      "label": "Audit",
      "type": "make audit",
      "pause_after": 7
    },
    {
      "label": "Tests",
      "type": "make test 2>&1 | tail -n 8",
      "pause_after": 5
    },
    {
      "label": "Challenge",
      "type": "make challenge 2>&1 | grep -E 'PASS|FAIL|ERROR|TESTS'",
      "pause_after": 7
    }
  ]
}
