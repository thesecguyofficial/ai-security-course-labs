{
  "name": "az14-14.8-understand-linux",
  "lesson": "14.0, 14.8 (Azure stream)",
  "title": "Lab AZ14, part 1: get the lab, look at Contoso's hosted-agent setup (version 1 and the hardened build), and see each Foundry piece on its own with explore.py (map, token, invoke, session, identity, tools, policy, egress, memory, sandbox, guardrail, logs) before attacking it; then one request read line by line",
  "cols": 132,
  "rows": 36,
  "before": [],
  "fail_on": [
    "Traceback",
    "No such file"
  ],
  "steps": [
    {
      "label": "Download",
      "type": "git clone https://github.com/thesecguyofficial/ai-security-course-labs.git",
      "pause_after": 3
    },
    {
      "label": "The lab",
      "type": "cd ai-security-course-labs/labs/az14 && ls",
      "pause_after": 4
    },
    {
      "label": "The setups",
      "type": "ls contoso fixes data",
      "pause_after": 4
    },
    {
      "label": "App notes",
      "type": "cat contoso/app.json",
      "pause_after": 5
    },
    {
      "label": "Setup plan",
      "type": "make -n setup",
      "pause_after": 3
    },
    {
      "label": "Setup",
      "type": "make setup",
      "pause_after": 3
    },
    {
      "label": "Map",
      "type": "python3 explore.py map contoso",
