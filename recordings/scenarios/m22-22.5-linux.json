{
  "name": "m22-22.5-linux",
  "lesson": "22.5",
  "title": "Lab 22.5, part 2: map the trifecta, score the single-model agent with AgentDojo, open the planted file, follow one planted address through three designs, score all four designs, the task the rebuild refuses, text-to-text and attacker text sent to an allowed reader, the hunt, the tests and the challenge",
  "cols": 132,
  "rows": 36,
  "before": [
    "git clone -q https://github.com/thesecguyofficial/ai-security-course-labs.git",
    "cd ai-security-course-labs/labs/m22 && make setup"
  ],
  "fail_on": [
    "Traceback",
    "No such file"
  ],
  "steps": [
    {
      "label": "Trifecta",
      "type": "cd ai-security-course-labs/labs/m22 && make trifecta",
      "pause_after": 6
    },
    {
      "label": "Before",
      "type": "make before",
      "pause_after": 6
    },
    {
      "label": "Attack file",
      "type": ".venv/bin/python explore.py planted UT3 IT0",
      "pause_after": 5
    },
    {
      "label": "Single",
      "type": ".venv/bin/python score.py --trace UT3 IT0 --agent single",
      "pause_after": 6
    },
    {
      "label": "Dual",
      "type": ".venv/bin/python score.py --trace UT3 IT0 --agent dual",
      "pause_after": 6
    },
    {
      "label": "Dual+taint",
      "type": ".venv/bin/python score.py --trace UT3 IT0 --agent dual+taint",
      "pause_after": 6
    },
    {
      "label": "Score",
      "type": "make score",
      "pause_after": 6
    },
    {
      "label": "Price",
      "type": ".venv/bin/python score.py --trace UT4 IT- --agent dual+taint",
      "pause_after": 5
    },
    {
      "label": "Text",
      "type": ".venv/bin/python score.py --trace UT0 IT3 --agent dual+taint",
      "pause_after": 6
    },
    {
      "label": "Reader",
      "type": ".venv/bin/python score.py --trace UT1 IT2 --agent dual+taint",
      "pause_after": 6
    },
    {
      "label": "Hunt",
      "type": "make hunt",
      "pause_after": 6
    },
    {
      "label": "Tests",
      "type": "make test 2>&1 | tail -n 3",
      "pause_after": 4
    },
    {
      "label": "Challenge",
      "type": "make challenge 2>&1 | grep -E 'FAIL|TESTS'",
      "pause_after": 6
    }
  ]
}
