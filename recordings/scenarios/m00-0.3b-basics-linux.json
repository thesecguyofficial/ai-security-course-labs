{
  "name": "m00-0.3b-basics-linux",
  "lesson": "0.3b",
  "title": "Tech basics, part 1: the terminal and git, how the web works, how apps talk (APIs and JSON), on a fresh machine",
  "cols": 110,
  "rows": 30,
  "fail_on": ["Traceback"],
  "steps": [
    {"label": "Where am I", "type": "pwd", "pause_after": 2},
    {"label": "Make a folder", "type": "mkdir notes", "pause_after": 1},
    {"label": "Make a folder", "type": "cd notes", "pause_after": 1},
    {"label": "Make a folder", "type": "pwd", "pause_after": 2},
    {"label": "A file", "type": "echo \"my first note\" > hello.txt", "pause_after": 1},
    {"label": "A file", "type": "ls -l", "pause_after": 2},
    {"label": "A file", "type": "cat hello.txt", "pause_after": 2},
    {"label": "Back up", "type": "cd ..", "pause_after": 1},
    {"label": "Clone", "type": "git clone https://github.com/thesecguyofficial/ai-security-course-labs.git", "pause_after": 3},
    {"label": "Inside the repository", "type": "cd ai-security-course-labs", "pause_after": 1},
    {"label": "Inside the repository", "type": "ls", "pause_after": 3},
    {"label": "Commits", "type": "git log --oneline -5", "pause_after": 4},
    {"label": "One commit", "type": "git show --stat HEAD | head -14", "pause_after": 5},
    {"label": "Pull", "type": "git pull", "pause_after": 3},
    {"label": "Markdown", "type": "head -12 README.md", "pause_after": 5},
    {"label": "A web page", "type": "curl -s https://example.com | head -16", "pause_after": 5},
    {"label": "The answer's first lines", "type": "curl -sI https://example.com | head -4", "pause_after": 4},
    {"label": "Not found", "type": "curl -sI https://github.com/thesecguyofficial/no-such-page | head -1", "pause_after": 3},
    {"label": "A public API", "type": "curl -s https://api.github.com/repos/thesecguyofficial/ai-security-course-labs | head -12", "pause_after": 5},
    {"label": "No key", "type": "curl -s https://api.github.com/user", "pause_after": 4},
    {"label": "Start a local server", "type": "cd labs/m00", "pause_after": 1},
    {"label": "Start a local server", "type": "python3 tiny_api.py & sleep 1", "pause_after": 3},
    {"label": "Who is listening", "type": "ss -ltn | grep 8080", "pause_after": 4},
    {"label": "Local web page", "type": "curl -i http://127.0.0.1:8080/", "pause_after": 5},
    {"label": "Local API, no key", "type": "curl -i http://127.0.0.1:8080/api/orders/1001", "pause_after": 4},
    {"label": "Local API, with key", "type": "curl -i -H \"Authorization: Bearer demo-key-123\" http://127.0.0.1:8080/api/orders/1001", "pause_after": 4},
    {"label": "Create an order", "type": "curl -i -X POST -H \"Authorization: Bearer demo-key-123\" -H \"Content-Type: application/json\" -d '{\"item\": \"tent\", \"qty\": 1}' http://127.0.0.1:8080/api/orders", "pause_after": 5},
    {"label": "Missing order", "type": "curl -i -H \"Authorization: Bearer demo-key-123\" http://127.0.0.1:8080/api/orders/9999", "pause_after": 4},
    {"label": "Stop the server", "type": "kill %1", "pause_after": 2}
  ]
}
