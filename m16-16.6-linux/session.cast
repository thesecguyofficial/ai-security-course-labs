[183.344343, "o", "\r\n\u001b[?2004l\r"]
[183.346389, "o", "python3 run_tests.py\r\n"]
[183.475253, "o", "[PASS] the simulator is deterministic: the same day on every computer\r\n"]
[183.475606, "o", "[PASS] first draft: management events only, no invocation logs, no AI Protection findings, no spans, no user IDs\r\n"]
[183.475687, "o", "[PASS] hardened: data events for mantle, AgentCore and the KB bucket; invocation logs never hold a mantle call\r\n[PASS] AI Protection findings: the three documented types, all Low (below 4.0); the prompt one has guardrail details\r\n"]
[183.481142, "o", "[PASS] a benign message that trips the guardrail at MEDIUM confidence makes no GuardDuty finding and no alert\r\n"]
[183.48163, "o", "[PASS] old rules, old logs: 1 of 5 caught (the logging-delete rule), 1 false alarm (the data science batch)\r\n"]
[183.482034, "o", "[PASS] old rules, new logs: the 'Medium and above' GuardDuty rule drops all four AI Protection findings\r\n"]
