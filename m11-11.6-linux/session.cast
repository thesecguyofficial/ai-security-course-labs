[39.534514, "o", "\r\n\u001b[?2004l\r"]
[39.536168, "o", "# \"We added PrivateLink, so it's private.\" No policy argument: the default endpoint policy applies.\r\nresource \"aws_vpc_endpoint\" \"bedrock_runtime\" {\r\n  vpc_id              = aws_vpc.helpdesk.id\r\n  service_name        = \"com.amazonaws.${var.region}.bedrock-runtime\"\r\n  vpc_endpoint_type   = \"Interface\"\r\n  private_dns_enabled = true\r\n  subnet_ids          = aws_subnet.private[*].id\r\n  security_group_ids  = [aws_security_group.endpoint.id]\r\n}\r\n\r\n# --- App role: copied from the old Helpdesk role\r\nresource \"aws_iam_role_policy\" \"app_invoke\" {\r\n  name = \"bedrock\"\r\n  role = aws_iam_role.app.id\r\n  policy = jsonencode({\r\n    Version = \"2012-10-17\"\r\n    Statement = [{\r\n"]
[39.536211, "o", "      Sid      = \"LetTheAppUseBedrock\"\r\n      Effect   = \"Allow\"\r\n      Action   = [\"bedrock:*\", \"bedrock-mantle:*\"]\r\n      Resource = \"*\"\r\n    }]\r\n  })\r\n}\r\n"]
