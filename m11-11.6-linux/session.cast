[60.063674, "o", "resource \"aws_nat_gateway\" \"nat\" {\r\n  allocation_id = aws_eip.nat.id\r\n  subnet_id     = aws_subnet.public.id\r\n}\r\n\r\nresource \"aws_route_table\" \"private\" {\r\n  vpc_id = aws_vpc.helpdesk.id\r\n  route {\r\n    cidr_block     = \"0.0.0.0/0\"\r\n    nat_gateway_id = aws_nat_gateway.nat.id\r\n  }\r\n}\r\n"]
[60.066362, "o", "\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kvariable \"\u001b[01;31m\u001b[Kinference_profile_id\u001b[m\u001b[K\" {\r\n\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  description = \"Global profile: about 10% cheaper, and it worked first time.\"\r\n\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  type        = string\r\n\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  default     = \"global.anthropic.claude-haiku-4-5-20251001-v1:0\"\r\n"]
