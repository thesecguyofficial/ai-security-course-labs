[27.675889, "o", "\u001b[A\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[Ky\r\n\u001b[?2004l\r"]
[27.677705, "o", "\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KALLOWED_SERVICES =\u001b[m\u001b[K {\"vpn\", \"email\", \"printer\", \"wifi\"}  # allow-list: the ONLY values the helper may receive\r\n"]
[27.677762, "o", "\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef render_answer_safe\u001b[m\u001b[K(answer: str) -> str:\r\n"]
[27.677886, "o", "\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    return f\"<p class='answer'>{\u001b[01;31m\u001b[Khtml.escape\u001b[m\u001b[K(answer, quote=True)}</p>\"\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef search_tickets_safe\u001b[m\u001b[K(user: str, term: str) -> list:\r\n\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    # connection. SQLite says \u001b[01;31m\u001b[Kquery_only\u001b[m\u001b[K is \"not truly read-only\" (COMMIT and checkpoints still work), so in\r\n\u001b[32m\u001b[K174\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    DB.execute(\"PRAGMA \u001b[01;31m\u001b[Kquery_only\u001b[m\u001b[K = ON\")\r\n\u001b[32m\u001b[K178\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        DB.execute(\"PRAGMA \u001b[01;31m\u001b[Kquery_only\u001b[m\u001b[K = OFF\")\r\n\u001b[32m\u001b[K216\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef service_status_safe\u001b[m\u001b[K(service: str) -> str:\r\n\u001b[32m\u001b[K274\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    enc = \u001b[01;31m\u001b[Khtml.escape\u001b[m\u001b[K if safe else (lambda s, quote=True: s)   # vulnerable mode doesn't encode anything\r\n\u001b[32m\u001b[K292\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K<form method=\"post\" action=\"/ask\"><input name=\"q\" size=\"60\" value=\"{\u001b[01;31m\u001b[Khtml.escape\u001b[m\u001b[K(question)}\" autofocus>\r\n"]
