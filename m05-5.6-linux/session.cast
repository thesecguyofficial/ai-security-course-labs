[109.055709, "o", "\r\n\u001b[?2004l\r"]
[109.057548, "o", "python3 run_tests.py\r\n"]
[109.192268, "o", "[PASS] vulnerable: model output lands in the page as live HTML (XSS)\r\n[PASS] vulnerable: model output rewrites the SQL query and leaks bob's tickets\r\n"]
[109.209273, "o", "[PASS] vulnerable: model output runs an extra shell command that reads the secrets file\r\n"]
[109.209339, "o", "[PASS] safe: the payload is HTML-encoded, so the browser shows it instead of running it\r\n"]
[109.209571, "o", "[PASS] safe: parameterised query returns only alice's tickets, and nothing for the injection string\r\n"]
[109.209663, "o", "[PASS] safe: the search runs read-only, and query_only is switched back off afterwards\r\n"]
[109.225953, "o", "[PASS] safe: the allow-list blocks the injected command, and the secret never appears\r\n"]
[109.241587, "o", "[PASS] safe: the helper runs with no inherited environment variables (no tokens or keys to steal)\r\n"]
[110.244251, "o", "[PASS] safe: a helper that hangs is stopped by the timeout\r\n"]
[110.259704, "o", "[PASS] safe: with no shell, ';' is just a character inside one argument, not a second command\r\n"]
[110.276963, "o", "[PASS] http: the vulnerable server sends the payload as live HTML, with no CSP\r\n"]
[110.277582, "o", "[PASS] http: the safe server encodes the payload AND sends a CSP that blocks scripts\r\n"]
[110.277622, "o", "[PASS] http: the app refuses to listen on anything but 127.0.0.1\r\n"]
