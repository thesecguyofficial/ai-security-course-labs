[42.498444, "o", "\r\n\u001b[?2004l\r"]
[42.500202, "o", "python3 run_tests.py\r\n"]
[42.655668, "o", "[PASS] vulnerable: model output lands in the page as live HTML (XSS)\r\n[PASS] vulnerable: model output rewrites the SQL query and leaks bob's tickets\r\n"]
[42.671912, "o", "[PASS] vulnerable: model output runs an extra shell command that reads the secrets file\r\n"]
[42.671974, "o", "[PASS] safe: the payload is HTML-encoded, so the browser shows it instead of running it\r\n"]
[42.672212, "o", "[PASS] safe: parameterised query returns only alice's tickets, and nothing for the injection string\r\n"]
[42.672326, "o", "[PASS] safe: the search runs read-only, and query_only is switched back off afterwards\r\n"]
[42.687443, "o", "[PASS] safe: the allow-list blocks the injected command, and the secret never appears\r\n"]
[42.701965, "o", "[PASS] safe: the helper runs with no inherited environment variables (no tokens or keys to steal)\r\n"]
[43.704522, "o", "[PASS] safe: a helper that hangs is stopped by the timeout\r\n"]
[43.720199, "o", "[PASS] safe: with no shell, ';' is just a character inside one argument, not a second command\r\n"]
[43.739715, "o", "[PASS] http: the vulnerable server sends the payload as live HTML, with no CSP\r\n"]
[43.740433, "o", "[PASS] http: the safe server encodes the payload AND sends a CSP that blocks scripts\r\n[PASS] http: the app refuses to listen on anything but 127.0.0.1\r\n"]
[44.241247, "o", "----------------------------------------------------------------------\r\nRan 13 tests in 1.586s\r\n\r\nOK\r\n\r\nALL TESTS PASSED (13 run)\r\n"]
