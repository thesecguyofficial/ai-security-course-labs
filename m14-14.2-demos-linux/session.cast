[57.056386, "o", "\r\n\u001b[?2004l\r"]
[57.104081, "o", "bob's token from the helpdesk-web app, sent to the runtime (first-draft)\r\n\r\n  no JWT authorizer here: inbound auth is IAM SigV4\r\n  the caller is an AWS role (your backend), so the token's user is never checked at this door\r\n"]
[57.110608, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m14\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m14\u001b[00m$ "]
