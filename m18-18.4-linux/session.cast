[76.105774, "o", "{\r\n  \"_evidence\": \"Sample evidence for the M18 lab (illustrative, fictional shop). Refund limits enforced in the refund tool's code, outside the model.\",\r\n  \"service\": \"tsg-helpdesk issue_refund\",\r\n  \"currency\": \"lab credits (fake)\",\r\n  \"max_per_call\": 50,\r\n  \"max_per_customer_per_day\": 100,\r\n  \"above_limit\": \"queue for human approval (control C04)\",\r\n  \"enforced_in\": \"refunds.py check_limits(), before the payment call\",\r\n  \"changed_by\": \"Platform engineering lead\",\r\n  \"change_ticket\": \"CHG-2026-1017\",\r\n  \"last_test\": \"2026-10-22: second refund of 60 on the same day for one customer was refused and queued\"\r\n}\r\n"]
