[83.68685, "o", "\r\n\u001b[?2004l\r"]
[83.688389, "o", "# Shared packages for the repo-root .venv that setup.sh / setup.ps1 create.\r\n#\r\n# Empty on purpose. Every lab's core steps (M1 to M14, all three cloud streams) use the Python standard\r\n# library only, so the shared .venv's job is to give you the right Python (3.11 or newer) everywhere.\r\n# Labs with packages pin and install them in their own folder, so one lab's versions never break another's:\r\n#   labs/m04  make setup   Presidio + spaCy English model (the big one, a few hundred MB)\r\n#   labs/m06  make setup   qdrant-client\r\n#   labs/m08  make setup   the MCP Python SDK\r\n#   labs/m09  make setup   picklescan, fickling, safetensors, numpy\r\n#   labs/m21  make setup   cedarpy (the Cedar policy engine)\r\n#   labs/m28  make setup   cryptography (AES-GCM for the local KMS and S3 stand-ins)\r\n#   labs/m25  make setup   model-signing (OpenSSF Model Signing) and its pinned dependencies\r\n#   labs/m26  make setup   PyYAML (reads compose and Kubernetes files)\r\n# Add a line here only for a package that several labs need with the same version.\r\n"]
[83.68867, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs\u001b[00m$ "]
[88.7397, "o", "exit\r\n\u001b[?2004l\r"]
[88.739783, "o", "exit\r\n"]
