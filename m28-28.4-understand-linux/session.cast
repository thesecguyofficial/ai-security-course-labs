[131.48759, "o", "e"]
[131.607265, "o", "x"]
[131.732802, "o", "p"]
[131.862733, "o", "l"]
[131.955463, "o", "o"]
[132.069564, "o", "r"]
[132.182473, "o", "e"]
[132.313624, "o", "."]
[132.443117, "o", "p"]
[132.573812, "o", "y"]
