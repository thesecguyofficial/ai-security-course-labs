[58.261904, "o", "\r\n\u001b[?2004l\r"]
[58.293799, "o", "trust boundary: Our servers\r\n   inside:   Chat app, Model, Ticketing system, Nightly import, Knowledge base\r\n   crossing: 3 flows\r\n      F1 chat message\r\n      F10 answer\r\n      F15 ticket text\r\n\r\ntrust boundary: Model boundary\r\n   inside:   Model\r\n   crossing: 3 flows\r\n      F2 UNTRUSTED: system prompt + chat\r\n      F4 UNTRUSTED: retrieved articles\r\n      F5 model output\r\n\r\n"]
[58.298525, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m02\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m02\u001b[00m$ "]
