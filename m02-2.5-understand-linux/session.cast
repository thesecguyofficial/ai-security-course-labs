[29.836914, "o", "\r\n\u001b[?2004l\r"]
[29.838481, "o", "{\r\n  \"version\": \"2.6.2\",\r\n  \"summary\": {\r\n    \"title\": \"TSG Helpdesk (starter)\",\r\n    \"owner\": \"The Sec Guy\",\r\n    \"description\": \"Starter data-flow diagram for lab 2.5: the chat path and the nightly ticket import. You add the tools, the MCP ticketing server, memory, the order database and the logs. Fake system; no threats yet.\",\r\n    \"id\": 0\r\n  },\r\n"]
[29.838844, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m02\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m02\u001b[00m$ "]
