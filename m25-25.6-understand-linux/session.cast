[214.073563, "o", "y"]
[214.561907, "o", "\r\n\u001b[?2004l\r"]
[214.56408, "o", ".venv/bin/python ci.py release hardened --version 1.1.0\r\n"]
[214.624076, "o", "CI [hardened] release 1.1.0: base tsg-guard-base, shipping int8 (int8)\r\n"]
[214.62499, "o", "  eval (full precision AND the shipped artefact): recall fp32 1.000, shipped 1.000, agreement 1.000\r\n"]
[214.946312, "o", "  signed 4 files -> 1.1.0-hardened/model.sig\r\n"]
[215.003657, "o", ".venv/bin/python deploy.py hardened release/1.1.0-hardened --emit state/create-model-package.json\r\n"]
[215.035297, "o", "DEPLOY [hardened] 1.1.0-hardened\r\n"]
[215.350144, "o", "  signature: verified\r\n  DEPLOYED: registered as version 1, ModelApprovalStatus Approved\r\n"]
[215.406986, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m25\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m25\u001b[00m$ "]
[222.458103, "o", "exit\r\n\u001b[?2004l\r"]
[222.458267, "o", "exit\r\n"]
