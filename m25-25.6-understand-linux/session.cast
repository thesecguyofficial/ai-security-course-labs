[87.071587, "o", "\r\n\u001b[?2004l\r"]
[87.073499, "o", "keys:\r\nattacker.priv  attacker.pub  ci.priv  ci.pub\r\n\r\nmodels:\r\n"]
[87.073599, "o", "\u001b[0m\u001b[01;34mcommunity-quant\u001b[0m  \u001b[01;34mcommunity-quant-v2\u001b[0m  \u001b[01;34mtsg-guard-base\u001b[0m  \u001b[01;34mtsg-guard-base-1.0\u001b[0m  \u001b[01;34munapproved-base\u001b[0m\r\n\r\nmodels/tsg-guard-base:\r\nconfig.json  model.safetensors\r\n"]
