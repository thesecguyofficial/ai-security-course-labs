{
  "_about": "IAM allow policies: per project, per bucket, per endpoint and per service account (who may act as it). keys lists user-managed service account keys that exist. Roles are expanded with ../../roles.json (a subset of each role's permissions).",
  "projects": {
    "example-summariser-prod": [
      {"role": "roles/aiplatform.user", "members": ["user:alice@example.com", "user:bob@example.com", "serviceAccount:tsg-helpdesk-app@example-summariser-prod.iam.gserviceaccount.com", "serviceAccount:tsg-ci-deployer@example-summariser-prod.iam.gserviceaccount.com", "user:ml-lead@example.com"]},
      {"role": "roles/iam.serviceAccountUser", "members": ["user:alice@example.com", "user:bob@example.com", "serviceAccount:tsg-ci-deployer@example-summariser-prod.iam.gserviceaccount.com"]},
      {"role": "roles/aiplatform.viewer", "members": ["group:all-staff@example.com"]},
      {"role": "roles/editor", "members": ["serviceAccount:100000000015-compute@developer.gserviceaccount.com"]},
      {"role": "roles/owner", "members": ["user:platform-admin@example.com"]},
      {"role": "roles/notebooks.admin", "members": ["user:alice@example.com", "user:bob@example.com"]}
    ],
    "example-summariser-dev": []
  },
  "buckets": {
