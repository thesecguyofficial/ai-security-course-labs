#!/bin/bash
# Runs once at boot on the optional test VM (no external IP). Calls Gemini on the host and location the Helpdesk is
# pinned to (eu: aiplatform.eu.rep.googleapis.com, reached through the regional PSC endpoint) with the attached service
# account (token from the metadata server), then tries the internet, and prints the results to the serial port.
# Read it with: gcloud compute instances get-serial-port-output helpdesk-vm --zone ${region}-a | grep TSG-SMOKE
TOKEN=$(curl -s -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
  | sed -E 's/.*"access_token":"([^"]+)".*/\1/')
echo "TSG-SMOKE resolve: $(getent hosts ${host})" > /dev/ttyS0
CODE=$(curl -s -m 20 -o /tmp/answer.json -w "%%{http_code}" -X POST \
  -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" \
  "https://${host}/v1/projects/${project}/locations/${location}/${model}:generateContent" \
  -d '{"contents":[{"role":"user","parts":[{"text":"Reply with the single word: private"}]}]}')
echo "TSG-SMOKE generateContent HTTP $CODE (${host}, locations/${location})" > /dev/ttyS0
head -c 400 /tmp/answer.json > /dev/ttyS0; echo > /dev/ttyS0
echo "TSG-SMOKE internet test: $(curl -s -m 5 -o /dev/null -w '%%{http_code}' https://example.com || echo blocked)" > /dev/ttyS0
