{
  "_note": "What is switched on to watch the endpoint.",
  "diagnostic_settings": {
    "endpoint:tsg-ml/tsg-summariser": ["AmlOnlineEndpointTrafficLog", "AmlOnlineEndpointEventLog", "AmlOnlineEndpointConsoleLog"],
    "ws:tsg-ml": ["ModelsChangeEvent", "ModelsReadEvent", "DataStoreChangeEvent", "ManagedNetworkEvent"]
