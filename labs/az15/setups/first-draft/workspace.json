{
  "_note": "What `az ml workspace show` returns, cut to the security settings (ARM property names). Keys starting with _ are lab notes.",
  "tsg-ml": {
    "publicNetworkAccess": "Enabled",
    "privateEndpoint": false,
    "managedNetwork": {"isolationMode": "AllowInternetOutbound", "outboundRules": {}},
    "identity": {"type": "SystemAssigned"},
    "encryption": {"status": "Disabled"},
    "v1LegacyMode": false,
    "_why": "Internet outbound so the deployment can pull weights and pip packages at start. Public access so the data scientists can use the studio from home."
  },
  "tsg-ml-dev": {
    "publicNetworkAccess": "Enabled",
    "privateEndpoint": false,
    "managedNetwork": {
      "isolationMode": "AllowOnlyApprovedOutbound",
      "firewallSku": "Standard",
      "outboundRules": {
        "huggingface": {"type": "FQDN", "destination": "huggingface.co"},
        "huggingface-sub": {"type": "FQDN", "destination": "*.huggingface.co"},
        "pypi": {"type": "FQDN", "destination": "pypi.org"},
        "pythonhosted": {"type": "FQDN", "destination": "*.pythonhosted.org"}
      }
    },
    "identity": {"type": "SystemAssigned"},
    "encryption": {"status": "Disabled"},
    "v1LegacyMode": false,
    "computes": [{"name": "ci-alice", "type": "ComputeInstance", "owner": "ds-alice"}, {"name": "ci-bob", "type": "ComputeInstance", "owner": "ds-bob"}],
    "_why": "Approved outbound, plus four FQDN rules so notebooks can download models and packages."
  }
}
