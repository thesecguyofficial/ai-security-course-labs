{
  "_note": "Built-in definition, copied from github.com/Azure/azure-policy (Cognitive Services/AllowDeployRegistryModels_Audit.json, version 1.0.2). policyRule and parameters are verbatim; the long description strings are omitted (read them at the source).",
  "source": "https://github.com/Azure/azure-policy/blob/master/built-in-policies/policyDefinitions/Cognitive%20Services/AllowDeployRegistryModels_Audit.json",
  "properties": {
    "displayName": "Foundry model deployments should only use approved models",
    "policyType": "BuiltIn",
    "mode": "Microsoft.CognitiveServices.Data",
    "metadata": {
      "version": "1.0.2",
      "category": "Cognitive Services"
    },
    "version": "1.0.2",
    "parameters": {
      "effect": {
        "type": "string",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy."
        }
      },
      "allowedPublishers": {
        "type": "Array",
        "defaultValue": [],
        "metadata": {
          "displayName": "Allowed Model Publishers",
          "description": "List of Publishers whose Models are allowed to be deployed."
        }
      },
      "allowedAssetIds": {
        "type": "Array",
        "defaultValue": [],
        "metadata": {
          "displayName": "Allowed Asset Ids"
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.CognitiveServices.Data/accounts/deployments"
          },
          {
            "allOf": [
              {
                "field": "Microsoft.CognitiveServices.Data/accounts/deployments/model.publisher",
                "notin": "[parameters('allowedPublishers')]"
              },
              {
                "count": {
                  "value": "[parameters('allowedAssetIds')]",
                  "name": "allowedAssetId",
                  "where": {
                    "field": "Microsoft.CognitiveServices.Data/accounts/deployments/model.assetId",
                    "contains": "[current('allowedAssetId')]"
                  }
                },
                "equals": 0
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  },
  "id": "/providers/Microsoft.Authorization/policyDefinitions/aafe3651-cb78-4f68-9f81-e7e41509110f",
  "name": "aafe3651-cb78-4f68-9f81-e7e41509110f"
}
