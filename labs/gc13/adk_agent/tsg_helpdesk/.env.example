# Copy to .env (never commit .env). Offline: leave as is. Cloud: GUIDED-BUILD.md tells you what to fill in.
TSG_MODE=offline                       # offline = stand-in model + twin retrieval; cloud = Gemini + RAG Engine
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=PROJECT_ID
GOOGLE_CLOUD_LOCATION=europe-west4
TSG_MODEL=gemini-3.1-flash-lite
TSG_CORPUS_STAFF=projects/PROJECT_ID/locations/europe-west4/ragCorpora/CORPUS_ID_STAFF
TSG_CORPUS_FINANCE=projects/PROJECT_ID/locations/europe-west4/ragCorpora/CORPUS_ID_FINANCE
TSG_MODEL_ARMOR_TEMPLATE=projects/PROJECT_ID/locations/europe-west4/templates/helpdesk-guard
TSG_SCREEN_TOOL_OUTPUT=1               # GUIDED-BUILD Step 5 switches this to 0 and back
