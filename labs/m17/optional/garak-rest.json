{
  "rest": {
    "RestGenerator": {
      "name": "TSG Helpdesk (local)",
      "uri": "http://127.0.0.1:8017/api/chat",
      "method": "post",
      "headers": {"Content-Type": "application/json"},
      "req_template_json_object": {"user": "bob", "message": "$INPUT"},
      "response_json": true,
      "response_json_field": "answer",
      "request_timeout": 10
    }
  }
}
