{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TryAnyModelAnywhere",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel*",
      "Resource": "arn:aws:bedrock:*::foundation-model/*"
    },
    {
      "Sid": "ReadOnlyCatalogue",
      "Effect": "Allow",
      "Action": ["bedrock:ListFoundationModels", "bedrock:GetFoundationModel"],
      "Resource": "*"
    }
  ]
}
