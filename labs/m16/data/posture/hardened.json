  {
   "resourceType": "AWS::BedrockAgentCore::CodeInterpreterCustom",
   "resourceId": "tsg_ci-Pp55Oo66Ii",
   "networkConfiguration": {
    "networkMode": "VPC"
   }
  },
  {
