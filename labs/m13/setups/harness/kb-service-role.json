{
  "_about": "Service role for the managed knowledge base: AWS's documented trust conditions and S3 statements.",
  "trust": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "Service": "bedrock.amazonaws.com"
        },
        "Action": "sts:AssumeRole",
        "Condition": {
          "StringEquals": {
            "aws:SourceAccount": "111122223333"
          },
          "ArnLike": {
            "AWS:SourceArn": "arn:aws:bedrock:us-east-1:111122223333:knowledge-base/*"
          }
        }
      }
    ]
  },
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "S3ListBucketStatement",
        "Effect": "Allow",
        "Action": [
          "s3:ListBucket"
        ],
        "Resource": [
          "arn:aws:s3:::amzn-s3-demo-bucket-tsg-kb"
        ],
        "Condition": {
          "StringEquals": {
            "aws:ResourceAccount": "111122223333"
          }
        }
      },
      {
        "Sid": "S3GetObjectStatement",
        "Effect": "Allow",
        "Action": [
          "s3:GetObject"
        ],
        "Resource": [
          "arn:aws:s3:::amzn-s3-demo-bucket-tsg-kb/*"
        ],
        "Condition": {
          "StringEquals": {
            "aws:ResourceAccount": "111122223333"
          }
        }
      }
    ]
  }
}
