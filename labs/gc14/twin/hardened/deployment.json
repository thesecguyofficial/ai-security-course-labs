 "access_policy": {
  "name": "projects/example-agents-prod/locations/global/accessPolicies/helpdesk-egress",
  "details": {
   "rules": [
    {
     "description": "deny-mail: the helpdesk agent never sends email itself",
     "effect": "DENY",
     "principals": [
      "principal://agents.global.org-100000000099.system.id.goog/resources/aiplatform/projects/100000000014/locations/europe-west4/reasoningEngines/1400000000000000003"
     ],
     "operation": {
      "permissions": [
       "iap.googleapis.com/resources.egressViaIAP"
      ]
     },
     "conditions": {
      "iap.googleapis.com": {
       "expression": "destination.agent_registry.mcp_server.name == 'projects/example-agents-prod/locations/europe-west4/mcpServers/mail'"
      }
     }
    },
    {
     "description": "allow-ticket-reads",
     "effect": "ALLOW",
     "principals": [
      "principal://agents.global.org-100000000099.system.id.goog/resources/aiplatform/projects/100000000014/locations/europe-west4/reasoningEngines/1400000000000000003"
     ],
     "operation": {
      "permissions": [
       "iap.googleapis.com/resources.egressViaIAP"
      ]
     },
     "conditions": {
      "iap.googleapis.com": {
       "expression": "destination.agent_registry.mcp_server.name == 'projects/example-agents-prod/locations/europe-west4/mcpServers/tickets' && destination.agent_registry.mcp_server.tool.annotations.read_only_hint == true"
      }
     }
    },
    {
     "description": "allow-ticket-writes",
     "effect": "ALLOW",
     "principals": [
      "principal://agents.global.org-100000000099.system.id.goog/resources/aiplatform/projects/100000000014/locations/europe-west4/reasoningEngines/1400000000000000003"
     ],
     "operation": {
      "permissions": [
       "iap.googleapis.com/resources.egressViaIAP"
      ]
     },
     "conditions": {
      "iap.googleapis.com": {
       "expression": "destination.agent_registry.mcp_server.name == 'projects/example-agents-prod/locations/europe-west4/mcpServers/tickets' && destination.agent_registry.mcp_server.tool.name in ['add_comment', 'close_ticket']"
      }
     }
    },
    {
     "description": "allow-bigquery-select",
     "effect": "ALLOW",
     "principals": [
      "principal://agents.global.org-100000000099.system.id.goog/resources/aiplatform/projects/100000000014/locations/europe-west4/reasoningEngines/1400000000000000003"
     ],
     "operation": {
      "permissions": [
       "iap.googleapis.com/resources.egressViaIAP"
      ]
     },
     "conditions": {
      "iap.googleapis.com": {
       "expression": "destination.agent_registry.mcp_server.name == 'projects/example-agents-prod/locations/europe-west4/mcpServers/bigquery' && destination.agent_registry.mcp_server.tool.name in ['execute_sql']"
      }
     }
    },
    {
     "description": "allow-google-endpoints",
     "effect": "ALLOW",
     "principals": [
      "principal://agents.global.org-100000000099.system.id.goog/resources/aiplatform/projects/100000000014/locations/europe-west4/reasoningEngines/1400000000000000003"
     ],
     "operation": {
      "permissions": [
       "iap.googleapis.com/resources.egressViaIAP"
      ]
     },
     "conditions": {
      "iap.googleapis.com": {
       "expression": "destination.agent_registry.resource_type == 'ENDPOINT'"
      }
     }
    }
   ]
  }
 },
