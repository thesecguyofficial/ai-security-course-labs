{
  "_about": "The hardened build. Same lab wrapper as contoso/deployment.json; property names follow Microsoft Learn where they exist.",
  "foundry_account": {"name": "contoso-ai2", "created": "2026-10-20", "network_injection": true, "disableLocalAuth": true},
  "project": {"name": "helpdesk", "created": "2026-10-20"},
  "registry": {"name": "crcontoso", "publicNetworkAccess": "Disabled"},
  "rai_policies": ["Microsoft.DefaultV2", "helpdesk-guardrail"],
  "agents": {
    "helpdesk-agent": {
      "definition": {
        "kind": "hosted",
        "cpu": "0.5", "memory": "1Gi",
        "protocol_versions": [{"protocol": "responses", "version": "2.0.0"}],
        "container_configuration": {"image": "crcontoso.azurecr.io/helpdesk-agent:1.1"},
        "environment_variables": {"MODEL_DEPLOYMENT_NAME": "helpdesk-chat",
                                  "TOOLBOX_MCP_ENDPOINT": "https://contoso-ai2.services.ai.azure.com/api/projects/helpdesk/toolboxes/helpdesk-tools/mcp?api-version=v1"},
        "rai_config": {"rai_policy_name": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-helpdesk/providers/Microsoft.CognitiveServices/accounts/contoso-ai2/raiPolicies/helpdesk-guardrail"}
      },
      "idle_timeout_minutes": 15,
      "runtime": {"approval_enforcement": "runtime", "policy_check": true, "local_tools": ["read_blob", "http_get"]},
      "debug_tools": [],
      "egressPolicy": {"mode": "Enforced", "defaultAction": "Deny", "rules": [
        {"name": "allow-contoso", "ruleType": "Fqdn", "match": {"host": "*.contoso.com"}, "action": {"actionType": "Allow"}},
        {"name": "allow-learn", "ruleType": "Fqdn", "match": {"host": "learn.microsoft.com"}, "action": {"actionType": "Allow"}}
      ]}
    },
    "helpdesk-admin-agent": {
      "definition": {"kind": "hosted", "cpu": "0.5", "memory": "1Gi",
                     "protocol_versions": [{"protocol": "responses", "version": "2.0.0"}],
                     "container_configuration": {"image": "crcontoso.azurecr.io/helpdesk-admin:1.1"},
                     "environment_variables": {"MODEL_DEPLOYMENT_NAME": "helpdesk-chat"},
                     "rai_config": {"rai_policy_name": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-helpdesk/providers/Microsoft.CognitiveServices/accounts/contoso-ai2/raiPolicies/helpdesk-guardrail"}},
      "idle_timeout_minutes": 15,
      "runtime": {"approval_enforcement": "runtime", "policy_check": true, "local_tools": []},
      "debug_tools": [],
      "egressPolicy": {"mode": "Enforced", "defaultAction": "Deny", "rules": [
        {"name": "allow-contoso", "ruleType": "Fqdn", "match": {"host": "*.contoso.com"}, "action": {"actionType": "Allow"}}]}
    }
  },
  "tracing": {"application_insights": true, "trace_readers": ["group:helpdesk-security"]},
  "red_team": {"last_run_version": "helpdesk-agent:1.1"}
}
