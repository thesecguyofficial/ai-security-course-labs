      {"category": "HARM_CATEGORY_DANGEROUS_CONTENT", "threshold": "BLOCK_MEDIUM_AND_ABOVE"},
      {"category": "HARM_CATEGORY_HARASSMENT", "threshold": "BLOCK_MEDIUM_AND_ABOVE"},
      {"category": "HARM_CATEGORY_HATE_SPEECH", "threshold": "BLOCK_MEDIUM_AND_ABOVE"},
      {"category": "HARM_CATEGORY_SEXUALLY_EXPLICIT", "threshold": "BLOCK_MEDIUM_AND_ABOVE"}
    ],
    "service_agent": "service-100000000002@gcp-sa-aiplatform.iam.gserviceaccount.com",
    "service_agent_roles": ["roles/modelarmor.user"]
  },
  "self_hosted": {
    "template": "projects/example-chatbot-prod/locations/europe-west4/templates/helpdesk-guard",
    "screen": "assembled_prompt",
    "screen_response": true,
    "endpoint": "modelarmor.europe-west4.rep.googleapis.com",
    "private_path": "psc-modelarmor-regional"
  },
  "sanitize_log_readers": ["group:ai-incident-readers@example.com"]
