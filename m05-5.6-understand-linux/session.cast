[182.874146, "o", "\r\n\u001b[?2004l\r"]
[182.880657, "o", "INFO SQL sent: SELECT id, assignee, title FROM tickets WHERE assignee = 'alice' AND title LIKE '%VPN%'\r\n"]
[182.880947, "o", "<!doctype html>\r\n<html><head><meta charset=\"utf-8\"><title>TSG Helpdesk (M5 lab, VULNERABLE)</title>\r\n<style>body{font-family:sans-serif;max-width:46rem;margin:2rem auto;padding:0 1rem}\r\ntable{border-collapse:collapse}td,th{border:1px solid #999;padding:.3rem .6rem}\r\n.answer{background:#f4f4f4;padding:.8rem}</style></head>\r\n<body><h1>TSG Helpdesk assistant</h1>\r\n<p>Mode: <b>VULNERABLE</b> &middot; signed in as <b>alice</b> (fake) &middot; model: stand-in or local only</p>\r\n<form method=\"post\" action=\"/ask\"><input name=\"q\" size=\"60\" value=\"search my tickets for VPN\" autofocus>\r\n<button>Ask</button></form>\r\n<p>Try: <i>summarise my latest ticket</i> &middot; <i>search my tickets for VPN</i> &middot;\r\n<i>check the status of vpn</i></p>\r\n<p class='answer'>Here are your tickets matching: VPN</p><table><tr><th>#</th><th>Assignee</th><th>Title</th></tr><tr><td>1</td><td>alice</td><td>VPN drops every hour</td></tr></table>\r\n"]
[182.881052, "o", "</body></html>"]
