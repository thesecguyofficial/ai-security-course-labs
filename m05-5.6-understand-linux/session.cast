[146.263586, "o", "\r\n\u001b[?2004l\r"]
[146.329803, "o", "the model's service: 'vpn'\r\n\r\nthe app hands ONE string to the shell (/bin/sh):\r\n   \"/usr/bin/python3\" tools/service_status.py vpn\r\n\r\nhow the shell reads it (';' means: then run the next command):\r\n   command 1: program /usr/bin/python3  arguments ['tools/service_status.py', 'vpn']\r\n\r\nwhat came back:\r\n"]
[146.330053, "o", "   app log: command run: \"/usr/bin/python3\" tools/service_status.py vpn\r\n"]
