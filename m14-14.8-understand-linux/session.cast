[39.630564, "o", "\r\n\u001b[?2004l\r"]
[39.632111, "o", "{\r\n  \"_about\": \"How the web backend and the agent code build each request. 'request' means a value the browser sent (anyone can forge it).\",\r\n  \"user_from\": \"session\",\r\n  \"runtime_session_id_from\": \"request\",\r\n  \"runtime_user_id_from\": \"request\",\r\n  \"agent_gateway_token\": \"agent_m2m\",\r\n  \"policy_session_id_from\": \"request\",\r\n  \"entrypoint_validates_prompt\": false,\r\n  \"memory_actor_id_from\": \"request\",\r\n  \"validate_memory_writes\": false\r\n}\r\n"]
