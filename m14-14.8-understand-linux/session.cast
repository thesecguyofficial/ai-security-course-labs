[98.123668, "o", "\r\n\u001b[?2004l\r"]
[98.173938, "o", "dana's token from the partner-portal app, sent to the gateway (first-draft)\r\n\r\n  discoveryUrl     https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE1/.well-known/openid-configuration\r\n  check 1  iss     matches the issuer from the discovery URL\r\n  skipped  allowedClients  not set, so nothing compares client_id\r\n  skipped  allowedAudience not set, so nothing compares aud\r\n  check    allowedScopes   [\"openid\", \"helpdesk/tools\"]  vs  scope = openid profile\r\n  skipped  customClaims    not set, so nothing compares custom claims\r\n\r\n=> accepted (allowedScopes checked)\r\n"]
[98.181502, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m14\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m14\u001b[00m$ "]
