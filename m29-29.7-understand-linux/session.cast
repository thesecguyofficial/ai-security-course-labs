[120.155313, "o", "\r\n\u001b[?2004l\r"]
[120.195267, "o", "The hardened rule honeytoken-key-used, checked against four logged calls (detect.py, the lab's EventBridge stand-in)\r\n\r\n  09:00:05  us-east-1      bedrock:InvokeModel                   svc-helpdesk-batch    no alert  pattern does not match\r\n  10:00:00  us-east-1      sts:GetCallerIdentity                 svc-reporting-legacy  ALERT     MATCH\r\n  10:00:20  us-east-1      bedrock:ListFoundationModels (denied) svc-reporting-legacy  ALERT     MATCH\r\n"]
[120.195412, "o", "  10:01:05  ap-southeast-2 bedrock:InvokeModel (denied)          svc-reporting-legacy  ALERT     MATCH\r\n\r\nThe first call used the app's own key: no match, no alert. The other three used the decoy: three alerts.\r\n"]
[120.20013, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m29\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m29\u001b[00m$ "]
