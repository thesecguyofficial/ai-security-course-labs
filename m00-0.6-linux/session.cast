[76.044066, "o", "\r\n\u001b[1m== 6. Lab models\u001b[0m\r\n"]
[76.054255, "o", "  \u001b[31m✗\u001b[0m gemma3:1b (about 806 MB)\r\n"]
[76.059297, "o", "  \u001b[31m✗\u001b[0m embeddinggemma (about 622 MB)\r\n"]
[76.060393, "o", "  gemma3:1b is the course's small chat model; embeddinggemma turns text into vectors (RAG labs).\r\n"]
[76.061409, "o", "  Download gemma3:1b embeddinggemma (about 1.4 GB for both)? [Y/n] "]
[77.313058, "o", "y"]
[77.728018, "o", "\r\n"]
[77.729689, "o", "  \u001b[1m$ env -u OLLAMA_HOST ollama pull gemma3:1b\u001b[0m\r\n"]
