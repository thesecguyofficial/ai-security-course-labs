[32.802742, "o", "\u001b[1mAI Security Engineer: lab setup\u001b[0m\r\nLog: /home/thesecguy/ai-security-course-labs/setup.log\r\n\r\n\u001b[1m== 1. This computer\u001b[0m\r\n"]
[32.808752, "o", "  \u001b[32m✓\u001b[0m Ubuntu 24.04.5 LTS (x86_64)\r\n"]
[32.812089, "o", "  \u001b[32m✓\u001b[0m Memory: 16 GB\r\n"]
[32.815414, "o", "  \u001b[32m✓\u001b[0m Free disk: 86 GB\r\n"]
[32.81749, "o", "\r\n\u001b[1m== 2. Basic tools: git, make, curl\u001b[0m\r\n"]
[32.818439, "o", "  \u001b[32m✓\u001b[0m git\r\n"]
[32.819372, "o", "  \u001b[32m✓\u001b[0m make\r\n"]
[32.820297, "o", "  \u001b[32m✓\u001b[0m curl\r\n"]
[32.821177, "o", "\r\n\u001b[1m== 3. Python 3.11 or newer\u001b[0m\r\n"]
[32.860316, "o", "  \u001b[32m✓\u001b[0m Python 3.12 at /usr/bin/python3.12\r\n"]
[32.901479, "o", "\r\n\u001b[1m== 4. Docker (runs lab apps in throwaway containers)\u001b[0m\r\n"]
[32.902686, "o", "  \u001b[31m✗\u001b[0m Docker\r\n"]
[32.903767, "o", "  Docker Engine from your distro's own package (docker.io): free, updated with your normal system updates.\r\n"]
[32.904823, "o", "  Install Docker Engine with apt? [Y/n] "]
[34.156636, "o", "y"]
[34.542992, "o", "\r\n"]
[34.54521, "o", "  (sudo may ask for your computer password for the next command)\r\n  \u001b[1m$ sudo apt-get update\u001b[0m\r\n"]
