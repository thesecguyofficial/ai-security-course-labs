[43.033367, "o", "Not building database; man-db/auto-update is not 'true'.\r\r\n"]
[43.623645, "o", "\r\nRunning kernel seems to be up-to-date.\r\n\r\nNo services need to be restarted.\r\n\r\n"]
[43.623722, "o", "No containers need to be restarted.\r\n\r\nNo user sessions are running outdated binaries.\r\n\r\nNo VM guests are running outdated hypervisor (qemu) binaries on this host.\r\n"]
[44.573149, "o", "  (sudo may ask for your computer password for the next command)\r\n  \u001b[1m$ sudo systemctl enable --now docker\u001b[0m\r\n"]
[44.857019, "o", "  Without the docker group you run Docker as 'sudo docker ...'. With it, no sudo, but Docker's own docs\r\n"]
[44.858408, "o", "  warn the group 'grants root-level privileges to the user'. Fine on your own laptop, not on a shared one.\r\n"]
[44.859855, "o", "  Add thesecguy to the docker group? [y/N] "]
[46.110878, "o", "\r\n"]
[46.402651, "o", "  \u001b[33m!\u001b[0m Docker runs, but only with sudo for your user (see the docker group question above).\r\n"]
[46.40441, "o", "\r\n\u001b[1m== 5. Ollama (runs AI models on this computer)\u001b[0m\r\n"]
[46.405937, "o", "  \u001b[31m✗\u001b[0m Ollama\r\n"]
[46.407423, "o", "  Ollama's official Linux installer is a script. It uses sudo to put ollama in /usr/local and,\r\n"]
[46.408834, "o", "  with systemd, adds an 'ollama' service that listens on 127.0.0.1 only.\r\n"]
[46.410334, "o", "  Download Ollama's installer from ollama.com? [Y/n] "]
[47.661332, "o", "y"]
[48.099008, "o", "\r\n"]
[48.10231, "o", "  \u001b[1m$ curl -fsSL --proto =https --tlsv1.2 -o /tmp/tmp.r0GnvFnO8J/ollama-install.sh https://ollama.com/install.sh\u001b[0m\r\n"]
[48.797311, "o", "  Downloaded https://ollama.com/install.sh\r\n"]
[48.803583, "o", "  to /tmp/tmp.r0GnvFnO8J/ollama-install.sh (455 lines, SHA-256 25f64b810b947145095956533e1bdf56eacea2673c55a7e586be4515fc882c9f)\r\n"]
[48.804949, "o", "  Read the script before it runs? (q quits the viewer) [Y/n] "]
[50.055875, "o", "y"]
[50.470263, "o", "\r\n"]
[50.473385, "o", "\u001b[?1049h\u001b[22;0;0t\u001b[?1h\u001b=\r"]
[50.473529, "o", "#!/bin/sh\r\n# This script installs Ollama on Linux and macOS.\r\n# It detects the current operating system architecture and installs the appropriate version of Ollam \ba.\r\n\r\n# Wrap script in main function so that a truncated partial download doesn't end\r\n# up executing half a script.\r\nmain() {\r\n\r\nset -eu\r\n\r\nred=\"$( (/usr/bin/tput bold || :; /usr/bin/tput setaf 1 || :) 2>&-)\"\r\nplain=\"$( (/usr/bin/tput sgr0 || :) 2>&-)\"\r\n\r\nstatus() { echo \">>> $*\" >&2; }\r\nerror() { echo \"${red}ERROR:${plain} $*\"; exit 1; }\r\nwarning() { echo \"${red}WARNING:${plain} $*\"; }\r\n\r\nTEMP_DIR=$(mktemp -d)\r\ncleanup() { rm -rf $TEMP_DIR; }\r\ntrap cleanup EXIT\r\n\r\navailable() { command -v $1 >/dev/null; }\r\nrequire() {\r\n    local MISSING=''\r\n\u001b[7m/tmp/tmp.r0GnvFnO8J/ollama-install.sh\u001b[27m\u001b[K"]
[55.524761, "o", "\r\u001b[K\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t"]
[55.525282, "o", "  Run ollama-install.sh now? [Y/n] "]
[56.776276, "o", "y"]
[57.169634, "o", "\r\n"]
[57.171421, "o", "  \u001b[1m$ sh /tmp/tmp.r0GnvFnO8J/ollama-install.sh\u001b[0m\r\n"]
