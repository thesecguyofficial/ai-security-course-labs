[33.215425, "o", "\r\n\u001b[?2004l\r"]
[33.222358, "o", "\u001b[1mAI Security Engineer: lab setup\u001b[0m\r\nLog: /home/thesecguy/ai-security-course-labs/setup.log\r\n"]
[33.222499, "o", "\r\n\u001b[1m== 1. This computer\u001b[0m\r\n"]
[33.228827, "o", "  \u001b[32m✓\u001b[0m Ubuntu 24.04.5 LTS (x86_64)\r\n"]
[33.232562, "o", "  \u001b[32m✓\u001b[0m Memory: 16 GB\r\n"]
[33.236528, "o", "  \u001b[32m✓\u001b[0m Free disk: 86 GB\r\n"]
[33.239278, "o", "\r\n\u001b[1m== 2. Basic tools: git, make, curl\u001b[0m\r\n"]
[33.240569, "o", "  \u001b[32m✓\u001b[0m git\r\n"]
[33.241961, "o", "  \u001b[32m✓\u001b[0m make\r\n"]
[33.243281, "o", "  \u001b[32m✓\u001b[0m curl\r\n"]
[33.244544, "o", "\r\n\u001b[1m== 3. Python 3.11 or newer\u001b[0m\r\n"]
[33.297524, "o", "  \u001b[32m✓\u001b[0m Python 3.12 at /usr/bin/python3.12\r\n"]
[33.364087, "o", "\r\n\u001b[1m== 4. Docker (runs lab apps in throwaway containers)\u001b[0m\r\n"]
[33.365554, "o", "  \u001b[31m✗\u001b[0m Docker\r\n"]
[33.366878, "o", "  Docker Engine from your distro's own package (docker.io): free, updated with your normal system updates.\r\n"]
[33.368321, "o", "  Install Docker Engine with apt? [Y/n] "]
[34.619311, "o", "y"]
[35.005894, "o", "\r\n"]
[35.007688, "o", "  (sudo may ask for your computer password for the next command)\r\n  \u001b[1m$ sudo apt-get update\u001b[0m\r\n"]
