[71.356693, "o", "  (sudo may ask for your computer password for the next command)\r\n  \u001b[1m$ sudo systemctl start ollama\u001b[0m\r\n"]
[71.473009, "o", "  \u001b[32m✓\u001b[0m Ollama answering on http://127.0.0.1:11434\r\n"]
[71.474633, "o", "\r\n\u001b[1m== 6. Lab models\u001b[0m\r\n"]
[71.488553, "o", "  \u001b[31m✗\u001b[0m gemma3:1b (about 806 MB)\r\n"]
[71.496108, "o", "  \u001b[31m✗\u001b[0m embeddinggemma (about 622 MB)\r\n"]
[71.49763, "o", "  gemma3:1b is the course's small chat model; embeddinggemma turns text into vectors (RAG labs).\r\n"]
[71.499001, "o", "  Download gemma3:1b embeddinggemma (about 1.4 GB for both)? [Y/n] "]
[72.750064, "o", "y"]
[73.165395, "o", "\r\n"]
[73.16729, "o", "  \u001b[1m$ env -u OLLAMA_HOST ollama pull gemma3:1b\u001b[0m\r\n"]
