[32.702096, "o", "\u001b[1mAI Security Engineer: lab setup\u001b[0m\r\nLog: /home/thesecguy/ai-security-course-labs/setup.log\r\n\r\n\u001b[1m== 1. This computer\u001b[0m\r\n"]
[32.70707, "o", "  \u001b[32m✓\u001b[0m Ubuntu 24.04.5 LTS (x86_64)\r\n"]
[32.710077, "o", "  \u001b[32m✓\u001b[0m Memory: 16 GB\r\n"]
[32.713232, "o", "  \u001b[32m✓\u001b[0m Free disk: 86 GB\r\n"]
[32.715384, "o", "\r\n\u001b[1m== 2. Basic tools: git, make, curl\u001b[0m\r\n"]
[32.716463, "o", "  \u001b[32m✓\u001b[0m git\r\n"]
[32.717638, "o", "  \u001b[32m✓\u001b[0m make\r\n"]
[32.71873, "o", "  \u001b[32m✓\u001b[0m curl\r\n"]
[32.719743, "o", "\r\n\u001b[1m== 3. Python 3.11 or newer\u001b[0m\r\n"]
[32.756376, "o", "  \u001b[32m✓\u001b[0m Python 3.12 at /usr/bin/python3.12\r\n"]
[32.800113, "o", "\r\n\u001b[1m== 4. Docker (runs lab apps in throwaway containers)\u001b[0m\r\n"]
[32.801427, "o", "  \u001b[31m✗\u001b[0m Docker\r\n"]
[32.80246, "o", "  Docker Engine from your distro's own package (docker.io): free, updated with your normal system updates.\r\n"]
[32.803475, "o", "  Install Docker Engine with apt? [Y/n] "]
[34.054239, "o", "y"]
[34.440771, "o", "\r\n"]
