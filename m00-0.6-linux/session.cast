[45.28016, "o", "\r\nRunning kernel seems to be up-to-date.\r\n\r\nNo services need to be restarted.\r\n\r\nNo containers need to be restarted.\r\n\r\nNo user sessions are running outdated binaries.\r\n\r\nNo VM guests are running outdated hypervisor (qemu) binaries on this host.\r\n"]
[46.073489, "o", "  (sudo may ask for your computer password for the next command)\r\n  \u001b[1m$ sudo systemctl enable --now docker\u001b[0m\r\n"]
[46.234692, "o", "  Without the docker group you run Docker as 'sudo docker ...'. With it, no sudo, but Docker's own docs\r\n"]
[46.2359, "o", "  warn the group 'grants root-level privileges to the user'. Fine on your own laptop, not on a shared one.\r\n"]
[46.236894, "o", "  Add thesecguy to the docker group? [y/N] "]
[47.489154, "o", "\r\n"]
[47.733993, "o", "  \u001b[33m!\u001b[0m Docker runs, but only with sudo for your user (see the docker group question above).\r\n"]
[47.735307, "o", "\r\n\u001b[1m== 5. Ollama (runs AI models on this computer)\u001b[0m\r\n"]
[47.736412, "o", "  \u001b[31m✗\u001b[0m Ollama\r\n"]
[47.737531, "o", "  Ollama's official Linux installer is a script. It uses sudo to put ollama in /usr/local and,\r\n"]
[47.738522, "o", "  with systemd, adds an 'ollama' service that listens on 127.0.0.1 only.\r\n"]
[47.739576, "o", "  Download Ollama's installer from ollama.com? [Y/n] "]
[48.991542, "o", "y"]
[49.429094, "o", "\r\n"]
[49.432151, "o", "  \u001b[1m$ curl -fsSL --proto =https --tlsv1.2 -o /tmp/tmp.cqxDFAWm5q/ollama-install.sh https://ollama.com/install.sh\u001b[0m\r\n"]
[49.764203, "o", "  Downloaded https://ollama.com/install.sh\r\n"]
[49.76944, "o", "  to /tmp/tmp.cqxDFAWm5q/ollama-install.sh (455 lines, SHA-256 25f64b810b947145095956533e1bdf56eacea2673c55a7e586be4515fc882c9f)\r\n"]
[49.77046, "o", "  Read the script before it runs? (q quits the viewer) [Y/n] "]
[51.021652, "o", "y"]
[51.436753, "o", "\r\n"]
[51.445038, "o", "\u001b[?1049h\u001b[22;0;0t\u001b[?1h\u001b=\r#!/bin/sh\r\n# This script installs Ollama on Linux and macOS.\r\n# It detects the current operating system architecture and installs the appropriate version of Ollam \ba.\r\n\r\n# Wrap script in main function so that a truncated partial download doesn't end\r\n# up executing half a script.\r\nmain() {\r\n\r\nset -eu\r\n\r\nred=\"$( (/usr/bin/tput bold || :; /usr/bin/tput setaf 1 || :) 2>&-)\"\r\nplain=\"$( (/usr/bin/tput sgr0 || :) 2>&-)\"\r\n\r\nstatus() { echo \">>> $*\" >&2; }\r\nerror() { echo \"${red}ERROR:${plain} $*\"; exit 1; }\r\nwarning() { echo \"${red}WARNING:${plain} $*\"; }\r\n\r\nTEMP_DIR=$(mktemp -d)\r\ncleanup() { rm -rf $TEMP_DIR; }\r\ntrap cleanup EXIT\r\n\r\navailable() { command -v $1 >/dev/null; }\r\nrequire() {\r\n    local MISSING=''\r\n\u001b[7m/tmp/tmp.cqxDFAWm5q/ollama-install.sh\u001b[27m\u001b[K"]
[56.497005, "o", "\r\u001b[K\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t"]
[56.497335, "o", "  Run ollama-install.sh now? [Y/n] "]
[57.748689, "o", "y"]
[58.142569, "o", "\r\n"]
[58.144112, "o", "  \u001b[1m$ sh /tmp/tmp.cqxDFAWm5q/ollama-install.sh\u001b[0m\r\n"]
