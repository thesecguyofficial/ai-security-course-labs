[71.021411, "o", "  \u001b[32m✓\u001b[0m Ollama answering on http://127.0.0.1:11434\r\n"]
[71.022788, "o", "\r\n\u001b[1m== 6. Lab models\u001b[0m\r\n"]
[71.035906, "o", "  \u001b[31m✗\u001b[0m gemma3:1b (about 806 MB)\r\n"]
[71.042218, "o", "  \u001b[31m✗\u001b[0m embeddinggemma (about 622 MB)\r\n"]
[71.043379, "o", "  gemma3:1b is the course's small chat model; embeddinggemma turns text into vectors (RAG labs).\r\n"]
[71.044461, "o", "  Download gemma3:1b embeddinggemma (about 1.4 GB for both)? [Y/n] "]
[72.295135, "o", "y"]
[72.710296, "o", "\r\n"]
[72.711748, "o", "  \u001b[1m$ env -u OLLAMA_HOST ollama pull gemma3:1b\u001b[0m\r\n"]
