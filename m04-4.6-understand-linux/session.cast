[27.395005, "o", "# M4.6 canaries: fake sensitive values that must NEVER appear in logs/ when redaction is on.\r\n# check_logs.py fails if any of these strings is found. One per line; # = comment.\r\nJane Doe\r\njane.doe@example.com\r\n202-555-0143\r\n4242 4242 4242 4242\r\nABCPE1234F\r\n203.0.113.42\r\nAKIAIOSFODNN7EXAMPLE\r\n# The next three come from the stand-in model's ANSWER (output redaction):\r\nJohn Smith\r\njohn.smith@example.org\r\n5555 5555 5555 4444\r\n198.51.100.7\r\n"]
