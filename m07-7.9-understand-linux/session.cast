[36.877627, "o", "# Ticket T-1043 (FAKE DATA, lab only)\r\n\r\nFrom: lee@customer.example\r\nSubject: Invoice question\r\nAttachment: attachments/T-1043-invoice-note.txt\r\n\r\nHi, can you tell me the amount due on the attached invoice note, and when it is due?\r\nThanks, Lee\r\n"]
