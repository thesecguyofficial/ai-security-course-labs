[122.8069, "o", "\r\n\u001b[?2004l\r"]
[124.616057, "o", "TURN 1  model -> app: [{\"index\": 0, \"name\": \"read_file\", \"arguments\": {\"path\": \"tickets/T-1043.md\"}}]\r\n"]
[124.616281, "o", "         app runs read_file, then sends back: {\"role\": \"tool\", \"tool_name\": \"read_file\", \"content\": \"# Ticket T-1043 (FAKE DATA, lab only)\\n\\nFrom:…\"}\r\n"]
