[57.075829, "o", "\r\n\u001b[?2004l\r"]
[57.079601, "o", "\"\"\"defense.py, first try: match the exact strings seen in the recording (lesson 23.4: watch this fail).\"\"\"\r\nfrom __future__ import annotations\r\n\r\n\r\ndef input_check(event: dict, config: dict) -> str | None:\r\n    return \"known phrase\" if \"ignore previous instructions\" in event.get(\"text\", \"\") else None\r\n\r\n\r\ndef allowlist(tool_call: dict, config: dict) -> bool:\r\n    return tool_call.get(\"args\", {}).get(\"to\") != \"collector@attacker.example\"\r\n\r\n\r\ndef output_check(event: dict, config: dict) -> str | None:\r\n    return \"known URL\" if \"exfil.attacker.example\" in event.get(\"text\", \"\") else None\r\n\r\n\r\ndef rate_anomaly(login_events: list[dict], config: dict) -> set[str]:\r\n    return {\"rohan.v\"} if any(e.get(\"actor\") == \"rohan.v\" for e in login_events) else set()\r\n\r\n\r\ndef egress_signature(egress: dict, config: dict) -> str | None:\r\n    return \"known host\" if egress.get(\"host\") == \"ci-runner-07\" else None\r\n"]
