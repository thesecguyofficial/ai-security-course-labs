[35.788776, "o", "\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    # \u001b[01;31m\u001b[KTODO\u001b[m\u001b[K (lesson 23.3): return a reason string when event[\"text\"] carries injection, else None.\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return None\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    # \u001b[01;31m\u001b[KTODO\u001b[m\u001b[K (lesson 23.3): return True only for permitted tool + destination, else False.\r\n\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return True\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    # \u001b[01;31m\u001b[KTODO\u001b[m\u001b[K (lesson 23.3): return a reason string when output leaks data to an outside host, else None.\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return None\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    # \u001b[01;31m\u001b[KTODO\u001b[m\u001b[K (lesson 23.3): return the set of accounts over the per-minute failed-login budget.\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return set()\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    # \u001b[01;31m\u001b[KTODO\u001b[m\u001b[K (lesson 23.2): return a reason string for a model-API call from a non-caller host, else None.\r\n\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return None\r\n"]
