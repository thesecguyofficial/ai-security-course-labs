[80.96786, "o", "\r\n\u001b[?2004l\r"]
[80.971375, "o", "\"\"\"defense.py: my five checks. Each reads one recorded event and returns a verdict. Behaviour, not wording.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport re\r\nfrom datetime import datetime\r\nfrom urllib.parse import urlsplit\r\n\r\nOVERRIDE = re.compile(r\"(?i)\\b(ignore|disregard|forget)\\b[^.]{0,20}\\b(previous|prior|earlier|above)\\b\"\r\n                      r\"[^.]{0,10}\\b(instructions|directions|rules)\\b|\\byou\\s+are\\s+now\\b|^\\s*system:\")\r\nHIDDEN = re.compile(r\"<!--.*?-->\", re.S)\r\nZERO_WIDTH = re.compile(r\"[\\u200b\\u200c\\u200d\\u2060\\ufeff]\")\r\nURL = re.compile(r\"https?://[^\\s\\\"'<>)]+\")\r\n\r\n\r\ndef input_check(event: dict, config: dict) -> str | None:\r\n    text = event.get(\"text\", \"\")\r\n    if HIDDEN.search(text):\r\n        return \"text hidden in an HTML comment\"\r\n    if ZERO_WIDTH.search(text):\r\n"]
[80.971435, "o", "        return \"zero-width characters\"\r\n    if OVERRIDE.search(ZERO_WIDTH.sub(\"\", text)):\r\n        return \"override phrasing aimed at instructions\"\r\n    return None\r\n"]
