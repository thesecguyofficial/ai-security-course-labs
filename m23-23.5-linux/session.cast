[104.616636, "o", "\r\n\u001b[?2004l\r"]
[104.618364, "o", "def rate_anomaly(login_events: list[dict], config: dict) -> set[str]:\r\n    budget, fails = config[\"rate\"][\"login_fail_per_min\"], {}\r\n    for e in login_events:\r\n        if e.get(\"result\") == \"fail\":\r\n            fails.setdefault(e[\"actor\"], []).append(datetime.fromisoformat(e[\"ts\"].replace(\"Z\", \"+00:00\")))\r\n    flagged = set()\r\n    for actor, times in fails.items():\r\n        times.sort()\r\n        for i, start in enumerate(times):\r\n            if sum(0 <= (t - start).total_seconds() <= 60 for t in times[i:]) > budget:\r\n                flagged.add(actor)\r\n    return flagged\r\n\r\n\r\ndef egress_signature(egress: dict, config: dict) -> str | None:\r\n    dest, host = egress.get(\"dest\", \"\").lower(), egress.get(\"host\", \"\")\r\n    is_model_api = any(dest == d or dest.endswith(\".\" + d) for d in config[\"model_api_domains\"])\r\n    if is_model_api and host not in config[\"model_callers\"]:\r\n        return f\"model API call from {host}, which is not a model caller\"\r\n    return None\r\n"]
