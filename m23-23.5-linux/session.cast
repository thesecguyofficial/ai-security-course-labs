[92.857084, "o", "\r\n\u001b[?2004l\r"]
[92.858872, "o", "def allowlist(tool_call: dict, config: dict) -> bool:\r\n    tool, args = tool_call.get(\"tool\"), tool_call.get(\"args\", {})\r\n    if tool not in config[\"allowed_tools\"]:\r\n        return False\r\n    if tool == \"send_email\":\r\n        return args.get(\"to\", \"\").rsplit(\"@\", 1)[-1].lower() in config[\"allowed_email_domains\"]\r\n    if tool == \"fetch_url\":\r\n        return (urlsplit(args.get(\"url\", \"\")).hostname or \"\") in config[\"allowed_fetch_hosts\"]\r\n    return True\r\n\r\n\r\ndef output_check(event: dict, config: dict) -> str | None:\r\n    for url in URL.findall(event.get(\"text\", \"\")):\r\n        parts = urlsplit(url)\r\n        if parts.hostname not in config[\"allowed_fetch_hosts\"] and parts.query:\r\n            return f\"data in a link to an outside host: {parts.hostname}\"\r\n    return None\r\n"]
