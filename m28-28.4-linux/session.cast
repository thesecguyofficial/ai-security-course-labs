[33.843856, "o", "{\r\n  \"_about\": \"First draft: the redactor's two hand-written patterns. Macie gets no custom data identifiers.\",\r\n  \"custom_data_identifiers\": [],\r\n  \"redactor_patterns\": [\r\n    {\r\n      \"name\": \"EMAIL\",\r\n      \"regex\": \"[a-z0-9._%+-]+@[a-z0-9.-]+\\\\.[a-z]{2,}\",\r\n      \"caseSensitive\": true\r\n    },\r\n    {\r\n      \"name\": \"CARD\",\r\n      \"regex\": \"\\\\b\\\\d{16}\\\\b\",\r\n      \"caseSensitive\": true\r\n    }\r\n  ]\r\n}\r\n"]
