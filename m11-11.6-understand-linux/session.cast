[69.328111, "o", "\r\n\u001b[?2004l\r"]
[69.329915, "o", "python3 package.py\r\nfor d in hardened first-draft; do \\\r\n  cp twin/offline_override.tf terraform/$d/zz_offline_override.tf && \\\r\n  ( cd terraform/$d && terraform init -input=false -no-color >/dev/null && terraform plan -input=false -no-color -out=tfplan >/dev/null && \\\r\n    terraform show -json tfplan > ../../twin/$d.plan.json ); rc=$?; \\\r\n  rm -f terraform/$d/zz_offline_override.tf terraform/$d/tfplan; [ $rc -eq 0 ] || exit $rc; \\\r\n  echo \"wrote twin/$d.plan.json\"; done\r\n"]
