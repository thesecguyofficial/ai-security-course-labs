[185.54843, "o", "\r\n\u001b[?2004l\r"]
[185.585377, "o", "KMS keys in the plan, hardened: 2   (showing: prompts)\r\n\r\n  aws_kms_key.prompts: tsg-helpdesk: Bedrock model invocation logs (prompts and answers)\r\n    rotation on, deletion waits 7 days after someone schedules it\r\n\r\n    KeyAdministrationByTheAccount\r\n        who  root                                         may  kms:*\r\n"]
[185.585524, "o", "    CloudWatchLogsForThePromptLogGroupOnly\r\n        who  logs.us-east-1.amazonaws.com                 may  kms:Encrypt, kms:Decrypt, kms:ReEncrypt*, kms:GenerateDat...\r\n        only if  kms:EncryptionContext:aws:logs:arn\r\n    BedrockLogDeliveryFromThisAccountOnly\r\n        who  bedrock.amazonaws.com                        may  kms:GenerateDataKey\r\n        only if  aws:SourceAccount, aws:SourceArn\r\n    BedrockLoggingRoleWritesThroughCloudWatchLogsOnly\r\n        who  role/tsg-helpdesk-bedrock-logging            may  kms:Encrypt, kms:ReEncrypt*, kms:Decrypt, kms:GenerateDat...\r\n        only if  kms:ViaService\r\n    InvestigatorsMayDecryptPromptLogs\r\n        who  role/tsg-helpdesk-log-investigator           may  kms:Decrypt\r\n\r\n"]
[185.591231, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m11\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m11\u001b[00m$ "]
