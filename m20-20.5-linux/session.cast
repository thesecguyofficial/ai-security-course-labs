[101.896134, "o", "\r\n\u001b[?2004l\r"]
[101.897827, "o", "\u001b[01;31m\u001b[K##\u001b[m\u001b[K Step 0 · Before you start (10 minutes)\r\n\u001b[01;31m\u001b[K##\u001b[m\u001b[K Part A · Build it (30 minutes)\r\n\u001b[01;31m\u001b[K##\u001b[m\u001b[K# A1 · The identity provider: Cognito with two users\r\n\u001b[01;31m\u001b[K##\u001b[m\u001b[K# A2 · One workload identity per agent, with an accountable owner\r\n\u001b[01;31m\u001b[K##\u001b[m\u001b[K# A3 · One IAM role per agent that needs a human on every session\r\n\u001b[01;31m\u001b[K##\u001b[m\u001b[K# A4 · A trail that records Identity data events\r\n\u001b[01;31m\u001b[K##\u001b[m\u001b[K Part B · Run it and prove it (30 minutes plus waiting for CloudTrail)\r\n\u001b[01;31m\u001b[K##\u001b[m\u001b[K# B1 · Normal runs\r\n\u001b[01;31m\u001b[K##\u001b[m\u001b[K# B2 · Three things that must fail\r\n\u001b[01;31m\u001b[K##\u001b[m\u001b[K# B3 · Change one setting and watch the proof break\r\n\u001b[01;31m\u001b[K##\u001b[m\u001b[K# B4 · Read the proof\r\n\u001b[01;31m\u001b[K##\u001b[m\u001b[K Cost and teardown (do it the same day)\r\n"]
