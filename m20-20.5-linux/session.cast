[66.348782, "o", "\u001b[01;31m\u001b[KQ1\u001b[m\u001b[K who acted for whom (SourceIdentity on the agent's role session):\r\n   user-u-1001-alice\r\n      2027-01-21T09:00:02Z  tsg-agent-orchestrator   identity tsg-orchestrator  GetWorkloadAccessTokenForJWT\r\n      2027-01-21T09:00:12Z  tsg-agent-tickets        identity tsg-tickets       GetWorkloadAccessTokenForJWT\r\n      2027-01-21T09:00:14Z  tsg-agent-tickets        identity tsg-tickets       GetResourceOauth2Token\r\n      2027-01-21T09:00:22Z  tsg-agent-mail           identity tsg-mail          GetWorkloadAccessTokenForJWT\r\n      2027-01-21T09:00:24Z  tsg-agent-mail           identity tsg-mail          GetResourceOauth2Token\r\n      2027-01-21T09:25:02Z  tsg-agent-tickets        identity tsg-tickets       GetWorkloadAccessTokenForJWT\r\n      2027-01-21T09:25:04Z  tsg-agent-tickets        identity tsg-tickets       GetResourceOauth2Token\r\n   user-u-1002-bob\r\n      2027-01-21T09:05:02Z  tsg-agent-orchestrator   identity tsg-orchestrator  GetWorkloadAccessTokenForJWT\r\n      2027-01-21T09:05:12Z  tsg-agent-tickets        identity tsg-tickets       GetWorkloadAccessTokenForJWT\r\n      2027-01-21T09:05:14Z  tsg-agent-tickets        identity tsg-tickets       GetResourceOauth2Token\r\n"]
