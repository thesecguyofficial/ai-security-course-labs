[150.245158, "o", "\r\n\u001b[?2004l\r"]
[150.275173, "o", "Contextual grounding compares the answer with the source and the question (tuned.json thresholds).\r\n\r\n  source   (grounding_source): \"To reset your VPN token, open the Self-Service portal, choose VPN token, then Re-sync. Lo...\"\r\n  question (query):            \"How much does a replacement VPN token cost?\"\r\n\r\n"]
[150.275544, "o", "  answer made up          \"A replacement VPN token costs ₹500 and arrives within two working days.\"\r\n         grounding 0.20 (needs 0.6)   relevance 1.00 (needs 0.1)   ->  BLOCKED\r\n"]
[150.275634, "o", "  answer from the source  \"To reset your VPN token, open the Self-Service portal, choose VPN token, then...\"\r\n         grounding 1.00 (needs 0.6)   relevance 0.50 (needs 0.1)   ->  passes\r\n\r\nThe stand-in scores by shared words; Bedrock uses a model. Same idea: new facts lower the grounding score.\r\n"]
[150.281765, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m12\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m12\u001b[00m$ "]
