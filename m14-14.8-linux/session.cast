[87.374789, "o", "\r\n\u001b[?2004l\r"]
[87.376371, "o", "python3 checker.py hardened\r\n"]
[87.405952, "o", "[MEDIUM] M14-20 (14.5) send_email is allowed to addresses outside example.com: an injected instruction can mail data out (challenge 1)\r\n[MEDIUM] M14-23 (14.6) memory writes are not validated: text the agent read in a tool result can become a long-term memory (challenge 2)\r\n\r\n0 HIGH, 2 MEDIUM, 0 LOW  (2 findings)\r\n"]
[87.410847, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m14\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m14\u001b[00m$ "]
