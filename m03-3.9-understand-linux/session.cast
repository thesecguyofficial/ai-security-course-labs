[202.078012, "o", "\r\n\u001b[?2004l\r"]
[202.079665, "o", "providers:\r\n  - id: http\r\n    label: supportbot-local\r\n    config:\r\n      url: http://127.0.0.1:8003/api/summarise\r\n      method: POST\r\n      headers:\r\n        Content-Type: application/json\r\n      body:\r\n        email: \"{{prompt}}\"\r\n        mode: summarise\r\n"]
[202.079798, "o", "      transformResponse: json     # the test assertions below see the app's JSON as `output`\r\n"]
