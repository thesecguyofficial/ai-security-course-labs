# The setup files are published with SHA-256 fingerprints (SHA256SUMS). Git must never change their line
# endings on checkout (Windows' core.autocrlf would), or the fingerprints would not match.
setup.sh          -text
setup.ps1         -text
tools/doctor.py   -text
SHA256SUMS        -text
# M18 evidence files are hashed (SHA-256) in the lab's evidence indexes: keep them byte-for-byte on every system.
labs/m18/evidence/** -text
