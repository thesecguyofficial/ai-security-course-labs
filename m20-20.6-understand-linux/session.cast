[89.638226, "o", "t"]
[90.096791, "o", "\r\n\u001b[?2004l\r"]
[90.178128, "o", "An agent asks for a token for ITSELF: no user, no sign-in page (grant_type=client_credentials)\r\nSetup: first-draft (the only one that lets tickets-agent do this)\r\n\r\n"]
[90.581191, "o", "   tickets-agent -> POST /token   client ID tickets-agent, secret (not shown)\r\n"]
[90.589374, "o", "   server answers 200: an access token that lives 3600 seconds\r\n\r\n"]
[90.589499, "o", "   sub    service-account-tickets-agent      the agent's own identity, not a person\r\n   azp    tickets-agent                      the agent asked for it\r\n   aud    tickets-api                        the one service it may call\r\n   scope  tickets:read                       the agent's OWN rights: every ticket, whoever asks\r\n   email  (none)                             no user on this token\r\n"]
[90.650624, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m20\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m20\u001b[00m$ "]
[98.301636, "o", "p"]
