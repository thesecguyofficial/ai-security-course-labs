[118.709625, "o", "\r\n\u001b[?2004l\r"]
[119.316059, "o", "Setup: hardened   identity provider: http://127.0.0.1:39311\r\n\r\n   helpdesk-app       bob signed in (code + PKCE): {aud=['orchestrator-agent', 'tickets-agent', 'mail-agent', 'tickets-api', 'mail-api'], scope=[tickets:read mail:send], lives 300s}\r\n   helpdesk-app       bob asks: 'Show me T-4712'\r\n   orchestrator-agent plan for bob: read T-4712\r\n   orchestrator-agent -> tickets-agent: exchanged for {aud=tickets-agent, scope=[tickets:read mail:send], lives 120s, act=orchestrator-agent}\r\n   tickets-agent      -> tickets-api: exchanged for {aud=tickets-api, scope=[tickets:read], lives 120s, act=tickets-agent <- orchestrator-agent}\r\n   tickets-api        GET T-4712 for bob via tickets-agent: ok\r\n\r\nAnswer (200): T-4712 'Printer on floor 3 jams': Jams on every second page since the toner change.\r\n\r\nWhat the APIs logged:\r\n   tickets-api GET    T-4712               ok       user=bob  via tickets-agent <- orchestrator-agent  \r\n"]
