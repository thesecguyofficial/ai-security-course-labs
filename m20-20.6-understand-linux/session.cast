[90.197969, "o", "t"]
[90.656459, "o", "\r\n\u001b[?2004l\r"]
[90.720083, "o", "An agent asks for a token for ITSELF: no user, no sign-in page (grant_type=client_credentials)\r\nSetup: first-draft (the only one that lets tickets-agent do this)\r\n\r\n"]
[91.37325, "o", "   tickets-agent -> POST /token   client ID tickets-agent, secret (not shown)\r\n"]
[91.380418, "o", "   server answers 200: an access token that lives 3600 seconds\r\n\r\n   sub    service-account-tickets-agent      the agent's own identity, not a person\r\n   azp    tickets-agent                      the agent asked for it\r\n   aud    tickets-api                        the one service it may call\r\n   scope  tickets:read                       the agent's OWN rights: every ticket, whoever asks\r\n   email  (none)                             no user on this token\r\n"]
[91.433454, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m20\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m20\u001b[00m$ "]
[99.084377, "o", "p"]
[99.220047, "o", "y"]
[99.332934, "o", "t"]
[99.447414, "o", "h"]
[99.561448, "o", "o"]
[99.647712, "o", "n"]
[99.758495, "o", "3"]
[99.85266, "o", " "]
