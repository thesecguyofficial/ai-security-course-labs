[40.694548, "o", "\r\n\u001b[?2004l\r"]
[40.69574, "o", "{\r\n  \"_note\": \"Allow-lists your defence reads. Everything else is denied or flagged. Addresses use reserved .example names (RFC 2606).\",\r\n  \"model_callers\": [\"app-web-01\", \"app-web-02\"],\r\n  \"model_api_domains\": [\"api.model-vendor.example\", \"api.other-model.example\"],\r\n  \"allowed_tools\": [\"search_kb\", \"get_ticket\", \"send_email\", \"fetch_url\"],\r\n  \"allowed_email_domains\": [\"tsg.example\"],\r\n  \"allowed_fetch_hosts\": [\"kb.tsg.example\", \"docs.tsg.example\", \"portal.tsg.example\"],\r\n  \"rate\": {\r\n    \"login_fail_per_min\": 5,\r\n    \"requests_per_min\": 30\r\n  }\r\n}\r\n"]
