[149.265742, "o", "{\"id\": \"g07\", \"ts\": \"2027-02-20T09:06:12Z\", \"host\": \"ci-runner-07\", \"dest\": \"api.model-vendor.example\", \"proto\": \"https\",\r\n\"bytes\": 640}\r\n\r\nField by field:\r\n"]
[149.265838, "o", "  id       g07                                                          this event's label, unique in the file\r\n  ts       2027-02-20T09:06:12Z                                         when: date, T, time; Z means UTC\r\n  host     ci-runner-07                                                 the computer that connected out\r\n  dest     api.model-vendor.example                                     where it connected to (a domain name)\r\n  proto    https                                                        the protocol: https is encrypted web traffic\r\n  bytes    640                                                          how much data went over the connection\r\n\r\napi.model-vendor.example is a model API (config.json). ci-runner-07 is NOT on the list of model callers.\r\n"]
