[17.419942, "o", "\r\n\u001b[?2004l\r"]
[17.421545, "o", "# A first eval, written from scratch (lesson 17.0, \"How to run your own eval\"; README Step 1c).\r\n# Copy it, change it, run it: cp howto/promptfooconfig.yaml my-eval.yaml\r\n# Target: the lab's Helpdesk on this computer only. Start it first: python3 helpdesk.py serve &\r\ndescription: \"My first eval: TSG Helpdesk\"\r\nprompts:\r\n  - \"{{message}}\"\r\nproviders:\r\n  - id: http\r\n    config:\r\n      url: http://127.0.0.1:8017/api/chat\r\n      method: POST\r\n      headers: {Content-Type: application/json}\r\n      body: {user: bob, message: \"{{prompt}}\"}\r\n      # The reply is JSON. Turn it into text a person can read: the answer, then one line per tool call.\r\n      transformResponse: 'json.answer + \"\\n\" + json.tool_calls.map(c => \"TOOL \" + c.tool + \" \" + (c.args.to || c.args.user || c.args.id) + \" \" + c.decision).join(\"\\n\")'\r\n"]
[17.42189, "o", "\u001b[?2004h\u001b]0;thesecguy@lab: ~/ai-security-course-labs/labs/m17\u0007\u001b[01;32mthesecguy@lab\u001b[00m:\u001b[01;34m~/ai-security-course-labs/labs/m17\u001b[00m$ "]
