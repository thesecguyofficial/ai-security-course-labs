[24.485578, "o", "  \u001b[01;31m\u001b[KHIGH\u001b[m\u001b[K    GC10-01  folders/111111111111 roles/editor\r\n  \u001b[01;31m\u001b[KHIGH\u001b[m\u001b[K    GC10-01  folders/111111111111 roles/editor\r\n  \u001b[01;31m\u001b[KHIGH\u001b[m\u001b[K    GC10-01  projects/example-chatbot-prod roles/editor\r\n  \u001b[01;31m\u001b[KHIGH\u001b[m\u001b[K    GC10-04  projects/example-chatbot-prod roles/aiplatform.admin\r\n  \u001b[01;31m\u001b[KHIGH\u001b[m\u001b[K    GC10-05  key chatbot-frontend\r\n  \u001b[01;31m\u001b[KHIGH\u001b[m\u001b[K    GC10-06  key ops-eval-key\r\n  \u001b[01;31m\u001b[KHIGH\u001b[m\u001b[K    GC10-16  repo/chatbot/settings.py:9\r\n"]
[24.485634, "o", "  \u001b[01;31m\u001b[KMEDIUM\u001b[m\u001b[K  GC10-03  organizations/123456789012 roles/aiplatform.user\r\n  \u001b[01;31m\u001b[KMEDIUM\u001b[m\u001b[K  GC10-07  key ops-eval-key\r\n  \u001b[01;31m\u001b[KMEDIUM\u001b[m\u001b[K  GC10-08  key store-locator-website\r\n  \u001b[01;31m\u001b[KMEDIUM\u001b[m\u001b[K  GC10-09  organizations/123456789012/policies/iam.managed.disableServiceAccountApiKeyCreation\r\n  \u001b[01;31m\u001b[KMEDIUM\u001b[m\u001b[K  GC10-10  organization\r\n  \u001b[01;31m\u001b[KMEDIUM\u001b[m\u001b[K  GC10-11  projects/example-chatbot-prod\r\n  \u001b[01;31m\u001b[KMEDIUM\u001b[m\u001b[K  GC10-11  projects/example-ds-sandbox\r\n  \u001b[01;31m\u001b[KMEDIUM\u001b[m\u001b[K  GC10-14  projects/example-chatbot-prod\r\n  \u001b[01;31m\u001b[KMEDIUM\u001b[m\u001b[K  GC10-14  projects/example-ds-sandbox\r\n  \u001b[01;31m\u001b[KMEDIUM\u001b[m\u001b[K  GC10-15  projects/example-ds-sandbox\r\n  \u001b[01;31m\u001b[KLOW\u001b[m\u001b[K     GC10-12  projects/example-ds-sandbox/policies/vertexai.allowedModels\r\n7 \u001b[01;31m\u001b[KHIGH\u001b[m\u001b[K, 10 \u001b[01;31m\u001b[KMEDIUM\u001b[m\u001b[K, 1 \u001b[01;31m\u001b[KLOW\u001b[m\u001b[K, 0 WARNING  (18 findings)\r\n"]
